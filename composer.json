{
  "name": "zunaflux/zunaflux",
  "description": "Lecteur RSS multi-utilisateur auto-hébergé.",
  "type": "project",
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "symfony/asset": "^8.1",
    "symfony/asset-mapper": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/mailer": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/monolog-bundle": "^4.0",
    "symfony/password-hasher": "^8.1",
    "symfony/rate-limiter": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/stimulus-bundle": "^2.30",
    "symfony/twig-bundle": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/yaml": "^8.1",
    "symfonycasts/tailwind-bundle": "^1.0",
    "twig/extra-bundle": "^3.22",
    "twig/twig": "^3.22"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.1",
    "phpunit/phpunit": "^12.4",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/maker-bundle": "^1.67",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/stopwatch": "^8.1",
    "symfony/web-profiler-bundle": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "cache:clear": "@php bin/console cache:clear",
    "post-install-cmd": [
      "@cache:clear"
    ],
    "post-update-cmd": [
      "@cache:clear"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
