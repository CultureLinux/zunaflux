# ZUNAFLUX_VAPID_PUBLIC_FILE=/chemin/vers/zunaflux-secrets/vapid-public.txt
# ZUNAFLUX_VAPID_PRIVATE_FILE=/chemin/vers/zunaflux-secrets/vapid-private.pem
