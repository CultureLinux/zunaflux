APP_ENV=prod
APP_SECRET=change-me
APP_TIMEZONE=Europe/Paris
DATABASE_URL="mysql://zunaflux:change-me@127.0.0.1:3306/zunaflux?serverVersion=mariadb-10.11.0&charset=utf8mb4"
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async
ZUNAFLUX_PAGE_SIZE=30
ZUNAFLUX_MAX_SUBSCRIPTIONS=100
ZUNAFLUX_PUBLIC_REGISTRATION=1
ZUNAFLUX_MEDIA_STORAGE=var/media
