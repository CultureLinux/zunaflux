<section class="notification-schedule mt-6 border border-line bg-surface" aria-labelledby="notification-schedule-title">
    <header class="notification-schedule-header">
        <span class="notification-schedule-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg></span>
        <div><p class="font-mono text-xs uppercase tracking-[.2em] text-accent">{{ 'À votre rythme'|trans }}</p><h2 id="notification-schedule-title" class="mt-2 font-serif text-2xl">{{ 'Quand recevoir les nouveautés ?'|trans }}</h2></div>
    </header>
    <p class="text-sm text-muted">{{ 'Un récapitulatif de toutes vos sources, uniquement quand il y a du nouveau.'|trans }}</p>
    <form class="notification-schedule-form" method="post" action="{{ path('app_preferences_notification_schedule') }}" data-notification-schedule>
        {% if schedule_error|default(null) %}<p class="border border-danger p-3 text-danger" role="alert">{{ schedule_error|trans }}</p>{% endif %}
        <fieldset class="notification-modes">
            <legend class="mb-3 font-semibold">{{ 'Votre rythme'|trans }}</legend>
            <label class="notification-choice notification-mode"><input type="radio" name="notification_mode" value="interval" {{ preference.notificationMode == 'interval' ? 'checked' }}><span><strong>{{ 'À intervalles réguliers'|trans }}</strong><small>{{ 'Espacez vos notifications'|trans }}</small></span></label>
            <label class="notification-choice notification-mode"><input type="radio" name="notification_mode" value="fixed" {{ preference.notificationMode == 'fixed' ? 'checked' }}><span><strong>{{ 'À heures choisies'|trans }}</strong><small>{{ 'Vos rendez-vous dans la journée'|trans }}</small></span></label>
        </fieldset>
        <fieldset class="notification-intervals" data-schedule-interval>
            <legend class="mb-3 font-semibold">{{ 'Recevoir un récapitulatif toutes les'|trans }}</legend>
            <div class="notification-interval-grid">
                {% for hours in [1, 2, 3, 4, 5, 6, 12] %}
                    <label class="notification-choice notification-interval"><input type="radio" name="notification_interval" value="{{ hours }}" {{ preference.notificationInterval == hours ? 'checked' }}><span><strong>{{ hours }}</strong><small>{{ (hours == 1 ? 'heure' : 'heures')|trans }}</small></span></label>
                {% endfor %}
            </div>
        </fieldset>
        <fieldset class="notification-hours" data-schedule-fixed aria-describedby="notification-hours-help">
            <legend class="mb-3 font-semibold">{{ 'Choisissez vos heures'|trans }}</legend>
            <div class="notification-hours-grid">
                {% for hour, label in {8: 'Le matin', 12: 'À midi', 18: 'En fin de journée', 22: 'Le soir'} %}
                    <label class="notification-choice notification-hour"><input type="checkbox" name="notification_times[]" value="{{ hour }}" {{ hour in preference.notificationTimes ? 'checked' }}><span><strong>{{ '%02d'|format(hour) }}<span class="notification-minute">:00</span></strong><small>{{ label|trans }}</small></span></label>
                {% endfor %}
            </div>
            <p id="notification-hours-help" class="mt-3 text-sm text-muted">{{ 'Une heure cochée : une fois par jour. Plusieurs heures : autant de rendez-vous possibles.'|trans }}</p>
        </fieldset>
        <div class="notification-schedule-note"><p>{{ 'Horaires dans votre fuseau : %timezone%.'|trans({'%timezone%': preference.timezone}) }}</p><p>{{ 'Pendant le silence nocturne, vos nouveautés attendent le prochain envoi autorisé.'|trans }}</p></div>
        <input type="hidden" name="_token" value="{{ csrf_token('notification-schedule') }}">
        <button class="notification-schedule-save" type="submit"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg>{{ 'Enregistrer mon rythme'|trans }}</button>
    </form>
</section>
