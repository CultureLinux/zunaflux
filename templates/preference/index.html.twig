{% extends 'base.html.twig' %}{% block title %}Préférences · Zunaflux{% endblock %}{% block body %}<main class="mx-auto min-h-screen max-w-3xl px-6 py-16"><p class="font-mono text-xs uppercase tracking-[.25em] text-cyan-300">Votre espace</p><h1 class="mt-4 font-serif text-5xl text-white">Préférences</h1>{% for message in app.flashes('success') %}<p class="mt-6 border border-emerald-400/40 p-3 text-emerald-200">{{ message }}</p>{% endfor %}<form class="mt-10 grid gap-6 border border-slate-700 bg-slate-900/60 p-6" method="post"><label>Thème <select name="theme"><option value="system" {{ preference.theme == 'system' ? 'selected' }}>Système</option><option value="light" {{ preference.theme == 'light' ? 'selected' }}>Clair</option><option value="dark" {{ preference.theme == 'dark' ? 'selected' }}>Sombre</option></select></label><label>Densité <select name="density"><option value="comfortable" {{ preference.density == 'comfortable' ? 'selected' }}>Confortable</option><option value="compact" {{ preference.density == 'compact' ? 'selected' }}>Compacte</option></select></label><label>Taille <select name="font_scale"><option value="small">Petite</option><option value="normal" selected>Normale</option><option value="large">Grande</option></select></label><label>Accent <select name="accent"><option value="cyan">Cyan</option><option value="orange">Orange</option><option value="emerald">Émeraude</option></select></label><label>Lecture <select name="read_mode"><option value="on_preview">À l’ouverture</option><option value="manual">Manuelle</option></select></label><label><input name="sidebar_collapsed" type="checkbox" value="1" {{ preference.sidebarCollapsed ? 'checked' }}> Sidebar repliée</label><label>Fuseau <input name="timezone" value="{{ preference.timezone }}"></label><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><button class="border border-cyan-300 px-4 py-3 text-cyan-200">Enregistrer</button></form><section class="mt-10 border border-slate-700 bg-slate-900/60 p-6"><h2 class="font-serif text-2xl text-white">Vos données</h2><p class="mt-2 text-sm text-slate-400">Téléchargement direct, sans archive conservée sur le serveur.</p><div class="mt-4 flex gap-3"><form method="post" action="{{ path('app_account_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('account-export') }}"><button class="border border-cyan-300 px-4 py-2 text-cyan-200">Exporter l’archive</button></form><form method="post" action="{{ path('app_opml_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('opml-export') }}"><button class="border border-slate-500 px-4 py-2 text-slate-200">Exporter OPML</button></form></div></section></main>{% endblock %}
