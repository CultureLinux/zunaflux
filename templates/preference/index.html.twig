{% extends 'base.html.twig' %}{% block title %}Préférences · Zunaflux{% endblock %}{% block body %}<main class="mx-auto min-h-screen max-w-3xl px-6 py-16"><p class="font-mono text-xs uppercase tracking-[.25em] text-accent">Votre espace</p><h1 class="mt-4 font-serif text-5xl text-foreground">Préférences</h1>{% for message in app.flashes('success') %}<p class="mt-6 border border-success p-3 text-success">{{ message }}</p>{% endfor %}<form class="mt-10 grid gap-6 border border-line bg-surface p-6" method="post"><label class="flex flex-wrap items-center justify-between gap-3">Thème <select class="min-w-40 max-w-full px-3 py-2" name="theme"><option value="system" {{ preference.theme == 'system' ? 'selected' }}>Système</option><option value="light" {{ preference.theme == 'light' ? 'selected' }}>Clair</option><option value="dark" {{ preference.theme == 'dark' ? 'selected' }}>Sombre</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Densité <select class="min-w-40 max-w-full px-3 py-2" name="density"><option value="comfortable" {{ preference.density == 'comfortable' ? 'selected' }}>Confortable</option><option value="compact" {{ preference.density == 'compact' ? 'selected' }}>Compacte</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Taille <select class="min-w-40 max-w-full px-3 py-2" name="font_scale"><option value="small" {{ preference.fontScale == 'small' ? 'selected' }}>Petite</option><option value="normal" {{ preference.fontScale == 'normal' ? 'selected' }}>Normale</option><option value="large" {{ preference.fontScale == 'large' ? 'selected' }}>Grande</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Accent <select class="min-w-40 max-w-full px-3 py-2" name="accent"><option value="cyan" {{ preference.accent == 'cyan' ? 'selected' }}>Cyan</option><option value="orange" {{ preference.accent == 'orange' ? 'selected' }}>Orange</option><option value="emerald" {{ preference.accent == 'emerald' ? 'selected' }}>Émeraude</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Lecture <select class="min-w-40 max-w-full px-3 py-2" name="read_mode"><option value="on_preview" {{ preference.readMode == 'on_preview' ? 'selected' }}>À l’ouverture</option><option value="manual" {{ preference.readMode == 'manual' ? 'selected' }}>Manuelle</option></select></label><label class="preference-switch"><span><span class="block">Vue de lecture en trois panneaux</span><span class="block text-sm text-muted">Sur ordinateur uniquement</span></span><input name="sidebar_collapsed" type="checkbox" role="switch" value="1" {{ preference.sidebarCollapsed ? 'checked' }}><span class="preference-switch-track" aria-hidden="true"></span></label><label class="flex flex-wrap items-center justify-between gap-3">Fuseau <input class="min-w-40 max-w-full px-3 py-2" name="timezone" value="{{ preference.timezone }}"></label><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><button class="inline-flex items-center justify-center gap-2 border border-accent px-4 py-3 text-accent hover:bg-accent-soft"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v6h9V3M7 21v-8h10v8"/></svg><span>Enregistrer</span></button></form>{% include 'preference/_notifications.html.twig' %}<section class="mt-10 border border-line bg-surface p-6"><h2 class="font-serif text-2xl text-foreground">Vos données</h2><p class="mt-2 text-sm text-muted">Téléchargement direct, sans archive conservée sur le serveur.</p><div class="mt-4 flex flex-wrap gap-3"><form method="post" action="{{ path('app_account_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('account-export') }}"><button class="inline-flex items-center gap-2 border border-accent px-4 py-2 text-accent hover:bg-accent-soft"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"/></svg><span>Exporter l’archive</span></button></form><form method="post" action="{{ path('app_opml_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('opml-export') }}"><button class="inline-flex items-center gap-2 border border-line px-4 py-2 text-accent hover:border-accent hover:bg-accent-soft"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"/></svg><span>Exporter OPML</span></button></form></div></section></main>{% endblock %}
