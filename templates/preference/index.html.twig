{% extends 'base.html.twig' %}{% block title %}Préférences · Zunaflux{% endblock %}{% block body %}<main class="mx-auto min-h-screen max-w-3xl px-6 py-16"><p class="font-mono text-xs uppercase tracking-[.25em] text-accent">Votre espace</p><h1 class="mt-4 font-serif text-5xl text-foreground">Préférences</h1>{% for message in app.flashes('success') %}<p class="mt-6 border border-success p-3 text-success">{{ message }}</p>{% endfor %}<form class="mt-10 grid gap-6 border border-line bg-surface p-6" method="post"><label>Thème <select name="theme"><option value="system" {{ preference.theme == 'system' ? 'selected' }}>Système</option><option value="light" {{ preference.theme == 'light' ? 'selected' }}>Clair</option><option value="dark" {{ preference.theme == 'dark' ? 'selected' }}>Sombre</option></select></label><label>Densité <select name="density"><option value="comfortable" {{ preference.density == 'comfortable' ? 'selected' }}>Confortable</option><option value="compact" {{ preference.density == 'compact' ? 'selected' }}>Compacte</option></select></label><label>Taille <select name="font_scale"><option value="small" {{ preference.fontScale == 'small' ? 'selected' }}>Petite</option><option value="normal" {{ preference.fontScale == 'normal' ? 'selected' }}>Normale</option><option value="large" {{ preference.fontScale == 'large' ? 'selected' }}>Grande</option></select></label><label>Accent <select name="accent"><option value="cyan" {{ preference.accent == 'cyan' ? 'selected' }}>Cyan</option><option value="orange" {{ preference.accent == 'orange' ? 'selected' }}>Orange</option><option value="emerald" {{ preference.accent == 'emerald' ? 'selected' }}>Émeraude</option></select></label><label>Lecture <select name="read_mode"><option value="on_preview" {{ preference.readMode == 'on_preview' ? 'selected' }}>À l’ouverture</option><option value="manual" {{ preference.readMode == 'manual' ? 'selected' }}>Manuelle</option></select></label><label><input name="sidebar_collapsed" type="checkbox" value="1" {{ preference.sidebarCollapsed ? 'checked' }}> Sidebar repliée</label><label>Fuseau <input name="timezone" value="{{ preference.timezone }}"></label><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><button class="border border-accent px-4 py-3 text-accent">Enregistrer</button></form><section class="mt-10 border border-line bg-surface p-6"><h2 class="font-serif text-2xl text-foreground">Vos données</h2><p class="mt-2 text-sm text-muted">Téléchargement direct, sans archive conservée sur le serveur.</p><div class="mt-4 flex flex-wrap gap-3"><form method="post" action="{{ path('app_account_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('account-export') }}"><button class="border border-accent px-4 py-2 text-accent">Exporter l’archive</button></form><form method="post" action="{{ path('app_opml_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('opml-export') }}"><button class="border border-line px-4 py-2 text-foreground">Exporter OPML</button></form></div></section></main>{% endblock %}
