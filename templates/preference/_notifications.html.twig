<section class="mt-10 border border-line bg-surface p-6" data-push-notifications data-messages="{{ {
    unavailable: 'Les notifications ne sont pas disponibles sur cet appareil ou ce serveur.'|trans,
    disabledHelp: 'Notifications désactivées sur cet appareil. L’autorisation du navigateur ne suffit pas : activez-les ici.'|trans,
    enabled: 'Notifications activées pour ce compte sur cet appareil.'|trans,
    otherAccount: 'Cet appareil possède un abonnement, mais pas pour ce compte. Activez les notifications ici.'|trans,
    subscriptionMissing: 'Cet abonnement n’est plus enregistré et a pu expirer. Réactivez les notifications sur cet appareil.'|trans,
    connecting: 'Connexion au service de notifications…'|trans,
    registering: 'Enregistrement de cet appareil…'|trans,
    refused: 'Firefox a refusé la demande. Vérifiez ses autorisations de notifications.'|trans,
    pushTimeout: 'Le service de notifications ne répond pas. Rechargez la page et réessayez.'|trans,
    serverTimeout: 'Le serveur ne répond pas pour enregistrer cet appareil. Réessayez.'|trans,
    serverError: 'Le serveur n’a pas enregistré cet appareil. Vérifiez la session et la configuration des notifications.'|trans,
    browserError: 'Le navigateur n’a pas pu créer l’abonnement aux notifications%detail%. Vérifiez sa connexion et les autorisations du site.'|trans,
    disabled: 'Notifications désactivées sur cet appareil.'|trans,
    disableError: 'Impossible de désactiver les notifications.'|trans,
    testSent: 'Notification de test envoyée. Vérifiez les notifications de cet appareil.'|trans,
    testError: 'Échec du test. Vérifiez l’activation et la configuration des notifications.'|trans,
    prepareError: 'Impossible de préparer les notifications sur cet appareil.'|trans
}|json_encode|e('html_attr') }}" data-public-key="{{ push_public_key|default('') }}" data-csrf="{{ csrf_token('push-subscription') }}" data-url="{{ path('app_push_subscription') }}" data-status-url="{{ path('app_push_subscription_status') }}" data-device-list="1">
    <h2 class="font-serif text-2xl text-foreground">{{ "Notifications"|trans }}</h2>
    <div data-push-controls>
    <p class="mt-2 text-sm text-muted">{{ "Recevez les nouveautés et les erreurs de collecte sur cet appareil."|trans }}</p>
    <div class="mt-4 flex flex-wrap gap-3">
        <button class="border border-accent px-4 py-3 text-accent" type="button" data-push-enable disabled>{{ "Activer sur cet appareil"|trans }}</button>
        <button class="border border-line px-4 py-3 text-accent" type="button" data-push-disable disabled>{{ "Désactiver sur cet appareil"|trans }}</button>
        {% if is_granted('ROLE_ADMIN') %}<button class="border border-line px-4 py-3 text-accent" type="button" data-push-test data-url="{{ path('app_admin_push_test') }}" disabled>{{ "Tester la notification"|trans }}</button>{% endif %}
    </div>
    <p class="mt-3 text-sm text-muted" role="status">{{ "Notifications indisponibles pour le moment."|trans }}</p>
    </div>
    <h3 class="mt-6 text-lg font-semibold">{{ 'Appareils enregistrés'|trans }}</h3>
    <p class="mt-1 text-sm text-muted">{{ 'Un envoi accepté ne garantit pas son affichage sur l’appareil.'|trans }}</p>
    <ul class="mt-3 grid gap-3">
        {% for device in push_devices %}
            <li class="border border-line p-4" data-push-device="{{ device.id }}">
                <div class="flex flex-wrap items-center justify-between gap-2"><p class="font-semibold" data-push-device-label>{{ device.deviceLabel|trans }}</p><span class="push-current-browser" data-push-current hidden><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>{{ 'Ce navigateur'|trans }}</span></div>
                <p class="mt-1 text-sm text-muted">
                    {% if device.lastResult == 'accepted' %}{{ 'Dernier envoi accepté par le service push'|trans }}{% elseif device.lastResult == 'failed' %}{{ 'Dernier envoi en échec'|trans }}{% else %}{{ 'Aucun résultat enregistré'|trans }}{% endif %}
                    {% if device.lastResultAt %} · <time datetime="{{ device.lastResultAt|date('c') }}">{{ device.lastResultAt|date('d/m/Y H:i', preference.timezone) }}</time>{% endif %}
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <form method="post" action="{{ path('app_push_device_action', {id: device.id, action: 'test'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('push-device-' ~ device.id) }}"><button class="border border-line px-3 py-2 text-accent" type="submit">{{ 'Tester cet appareil'|trans }}</button></form>
                    <form method="post" action="{{ path('app_push_device_action', {id: device.id, action: 'delete'}) }}" data-push-device-delete><input type="hidden" name="_token" value="{{ csrf_token('push-device-' ~ device.id) }}"><button class="border border-line px-3 py-2 text-accent" type="submit">{{ 'Supprimer cet appareil'|trans }}</button></form>
                </div>
            </li>
        {% else %}
            <li class="text-sm text-muted">{{ 'Aucun appareil enregistré.'|trans }}</li>
        {% endfor %}
    </ul>
    {% for notice in push_notices %}
        <div class="mt-3 border border-line p-4" role="status">
            <p>{{ 'Un abonnement de notifications a expiré : %device%. Réactivez les notifications sur cet appareil.'|trans({'%device%': notice.deviceLabel|trans}) }}</p>
            <p class="mt-1 text-sm text-muted"><time datetime="{{ notice.expiredAt|date('c') }}">{{ notice.expiredAt|date('d/m/Y H:i', preference.timezone) }}</time></p>
            <form class="mt-2" method="post" action="{{ path('app_push_notice_dismiss', {id: notice.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('push-notice-' ~ notice.id) }}"><button class="text-accent underline" type="submit">{{ 'Masquer cet avis'|trans }}</button></form>
        </div>
    {% endfor %}
</section>
<script src="{{ asset('push.js') }}" defer></script>
<section class="mt-10 border border-line bg-surface p-6" aria-labelledby="quiet-hours-title"><h2 id="quiet-hours-title" class="font-serif text-2xl">Silence nocturne</h2><p class="mt-2 text-sm text-muted">Aucune notification n’est envoyée pendant cette plage, dans votre fuseau horaire. Laissez les deux horaires vides pour la désactiver.</p><form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="{{ path('app_preferences_quiet_hours') }}"><label>De <input class="mt-1 w-full border border-line bg-background px-3 py-2" type="time" name="quiet_start" value="{{ preference.quietStart }}"></label><label>À <input class="mt-1 w-full border border-line bg-background px-3 py-2" type="time" name="quiet_end" value="{{ preference.quietEnd }}"></label><input type="hidden" name="_token" value="{{ csrf_token('quiet-hours') }}"><button class="min-h-11 border border-accent px-4 text-accent sm:col-span-2" type="submit">Enregistrer le silence nocturne</button></form></section>
