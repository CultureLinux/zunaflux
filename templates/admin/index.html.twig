{% extends 'base.html.twig' %}
{% block title %}Administration · Zunaflux{% endblock %}
{% block body %}
<main class="mx-auto min-h-screen max-w-6xl px-6 py-16">
 <p class="font-mono text-xs uppercase tracking-[.25em] text-muted">Administration</p><h1 class="mt-4 font-serif text-5xl text-foreground">Comptes & santé</h1>
 <p class="mt-4 text-muted">{{ users|length }} comptes · {{ subscriptionCount }} abonnements · {{ feedCount }} flux partagés</p>
 {% for message in app.flashes('success') %}<p class="mt-6 border border-success p-3 text-success">{{ message }}</p>{% endfor %}
 {% for message in app.flashes('error') %}<p class="mt-6 border border-danger p-3 text-danger">{{ message }}</p>{% endfor %}
 {% if unusedFeeds is not empty %}<section class="mt-10" data-unused-feeds><h2 class="font-serif text-3xl text-foreground">Flux sans abonné</h2><p class="mt-2 text-sm text-muted">Les flux encore associés à un abonnement désactivé ne sont pas inclus.</p><ul class="mt-4 divide-y divide-line border-y border-line">{% for feed in unusedFeeds %}<li class="flex flex-wrap items-center justify-between gap-4 py-4"><div class="min-w-0 break-words">{{ feed.title ?: feed.canonicalUrl }}{% if feed.title %}<span class="mt-1 block break-all text-xs text-muted">{{ feed.canonicalUrl }}</span>{% endif %}</div>{% include 'admin/_delete_feed.html.twig' with {feed: feed, scope: 'unused'} %}</li>{% endfor %}</ul></section>{% endif %}
 {% if incidents is not empty %}<section class="mt-10" data-open-incidents><h2 class="font-serif text-3xl text-foreground">Incidents ouverts</h2><ul class="mt-4 divide-y divide-line border-y border-danger">{% for incident in incidents %}<li class="flex flex-wrap items-center justify-between gap-4 py-4"><div class="min-w-0 break-words"><p class="font-semibold text-foreground">{{ incident.feed.title ?: incident.feed.canonicalUrl }}</p><p class="mt-1 text-danger">{{ incident.message|incident_description }}</p><p class="mt-1 text-sm text-muted">{{ incident.occurrences }} échec(s)</p><details class="mt-2 text-sm text-muted"><summary class="cursor-pointer">Détails techniques</summary><p class="mt-1 break-all">{{ incident.message }}</p></details></div><div class="flex flex-wrap items-center gap-3"><form method="post" action="{{ path('app_admin_incident_acknowledge', {id: incident.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('incident-' ~ incident.id) }}"><button class="inline-flex min-h-11 items-center border border-line px-3 text-accent hover:border-accent hover:bg-accent-soft">Acquitter</button></form>{% include 'admin/_delete_feed.html.twig' with {feed: incident.feed, scope: 'incident'} %}</div></li>{% endfor %}</ul></section>{% endif %}
 <section class="mt-12"><h2 class="font-serif text-3xl text-foreground">Comptes</h2><div class="mt-5 overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th>Compte</th><th>Actif</th><th>Admin</th><th>Quota</th><th></th></tr></thead><tbody>{% for user in users %}<tr><form method="post" action="{{ path('app_admin_user_update', {id: user.id}) }}"><td>{{ user.userIdentifier }}</td><td><input name="enabled" type="checkbox" value="1" {{ user.active ? 'checked' }}></td><td><input name="admin" type="checkbox" value="1" {{ user.admin ? 'checked' }}></td><td><input class="w-20" name="subscription_limit" min="1" type="number" value="{{ user.subscriptionLimit }}"></td><td><input type="hidden" name="_token" value="{{ csrf_token('admin-user-' ~ user.id) }}"><button class="inline-flex items-center gap-2 text-accent hover:underline"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v6h9V3M7 21v-8h10v8"/></svg><span>Sauver</span></button></td></form></tr><tr><td colspan="5" class="pb-5 text-xs text-muted">{% if not user.active %}<form class="flex gap-2" method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"><input name="confirmation" placeholder="SUPPRIMER" aria-label="Confirmation de suppression"><input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}"><button class="inline-flex items-center gap-2 text-danger hover:underline"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg><span>Supprimer définitivement</span></button></form>{% else %}Désactivez d’abord ce compte avant une suppression définitive.{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
</main>
<script type="module" src="{{ asset('controllers/confirm-feed-delete.js') }}"></script>
{% endblock %}
