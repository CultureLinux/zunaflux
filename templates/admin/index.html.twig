{% extends 'base.html.twig' %}
{% block title %}Administration · Zunaflux{% endblock %}
{% block body %}
<main class="mx-auto min-h-screen max-w-6xl px-6 py-16">
 <p class="font-mono text-xs uppercase tracking-[.25em] text-muted">{{ "Administration"|trans }}</p><h1 class="mt-4 font-serif text-5xl text-foreground">{{ 'Comptes & santé'|trans }}</h1>
 <p class="mt-4 text-muted">{{ '%users% comptes · %subscriptions% abonnements · %feeds% flux partagés'|trans({'%users%': users|length, '%subscriptions%': subscriptionCount, '%feeds%': feedCount}) }}</p>
 <section class="mt-10 border border-line p-5" aria-labelledby="registration-limit-title"><h2 id="registration-limit-title" class="font-serif text-2xl">{{ "Limite d’inscriptions"|trans }}</h2><p class="mt-2 text-sm text-muted">{{ '%count% compte(s) existant(s), y compris les comptes désactivés. Une limite vide autorise un nombre illimité de comptes.'|trans({'%count%': users|length}) }}</p><form class="mt-4 flex flex-wrap items-end gap-3" method="post" action="{{ path('app_admin_registration_limit') }}"><label class="grid gap-1 text-sm" for="account-limit">{{ "Nombre maximal de comptes"|trans }}<input class="w-40 border border-line bg-background px-3 py-2 disabled:opacity-50" id="account-limit" name="account_limit" type="number" min="1" max="2147483647" value="{{ registrationLimit }}" {{ registrationLimitLocked ? 'disabled' }}></label><input type="hidden" name="_token" value="{{ csrf_token('registration-limit') }}"><button class="min-h-11 border border-line px-4 text-accent disabled:opacity-50" type="submit" {{ registrationLimitLocked ? 'disabled' }}>{{ "Enregistrer"|trans }}</button></form>{% if registrationLimitLocked %}<p class="mt-2 text-sm text-muted">{{ 'Limite imposée par ZUNAFLUX_MAX_ACCOUNTS dans l’environnement.'|trans }}</p>{% endif %}</section>
 <section class="mt-10" aria-labelledby="stats-title">
  <h2 id="stats-title" class="font-serif text-3xl text-foreground">{{ 'Activité des 30 derniers jours'|trans }}</h2>
  <p class="mt-2 text-sm text-muted">{{ 'Flux et comptes créés, articles collectés, encore présents dans la base. Les suppressions ne sont pas représentées. Les notifications comptent les envois acceptés par le service push, tests compris, à partir de l’activation du compteur. Chaque graphique possède sa propre échelle.'|trans }}</p>
  <div class="mt-5 grid gap-4 md:grid-cols-3">{% for label, days in stats %}
   {% set maximum = max(1, max(days|map(day => day.count))) %}
   <div class="min-w-0 border border-line p-4"><h3 class="font-semibold text-foreground">{{ label|trans|capitalize }}</h3>
    <p class="mt-1 text-sm text-muted">{{ '%count% sur la période'|trans({'%count%': days|reduce((total, day) => total + day.count, 0)}) }}</p>
    <div class="mt-4 flex h-28 items-end gap-px" aria-hidden="true">{% for day in days %}<div class="min-w-0 flex-1 bg-accent" style="height: {{ (day.count / maximum * 100)|round }}%" title="{{ day.date }} : {{ day.count }}"></div>{% endfor %}</div>
    <div class="mt-2 flex justify-between text-xs text-muted"><span>{{ (days|first).date|date('d/m') }}</span><span>{{ (days|last).date|date('d/m') }}</span></div>
    <details class="mt-3 text-sm text-muted"><summary class="cursor-pointer">{{ 'Détail par jour'|trans }}</summary><ul class="mt-2">{% for day in days %}<li>{{ day.date|date('d/m/Y') }} : {{ day.count }}</li>{% endfor %}</ul></details>
   </div>{% endfor %}</div>
 </section>
 {% if unusedFeeds is not empty %}<section class="mt-10" data-unused-feeds><h2 class="font-serif text-3xl text-foreground">{{ "Flux sans abonné"|trans }}</h2><p class="mt-2 text-sm text-muted">{{ 'Les flux encore associés à un abonnement désactivé ne sont pas inclus.'|trans }}</p><ul class="mt-4 divide-y divide-line border-y border-line">{% for feed in unusedFeeds %}<li class="flex flex-wrap items-center justify-between gap-4 py-4"><div class="min-w-0 break-words">{{ feed.title ?: feed.canonicalUrl }}{% if feed.title %}<span class="mt-1 block break-all text-xs text-muted">{{ feed.canonicalUrl }}</span>{% endif %}</div>{% include 'admin/_delete_feed.html.twig' with {feed: feed, scope: 'unused'} %}</li>{% endfor %}</ul></section>{% endif %}
 {% if incidents is not empty %}<section class="mt-10" data-open-incidents><h2 class="font-serif text-3xl text-foreground">{{ "Incidents ouverts"|trans }}</h2><ul class="mt-4 divide-y divide-line border-y border-danger">{% for incident in incidents %}<li class="flex flex-wrap items-center justify-between gap-4 py-4"><div class="min-w-0 break-words"><p class="font-semibold text-foreground">{{ incident.feed.title ?: incident.feed.canonicalUrl }}</p><p class="mt-1 text-danger">{{ incident.message|incident_description }}</p><p class="mt-1 text-sm text-muted">{{ '%count% échec(s)'|trans({'%count%': incident.occurrences}) }}</p><details class="mt-2 text-sm text-muted"><summary class="cursor-pointer">{{ "Détails techniques"|trans }}</summary><p class="mt-1 break-all">{{ incident.message }}</p></details></div><div class="flex flex-wrap items-center gap-3"><form method="post" data-feed-retry-form action="{{ path('app_admin_incident_retry', {id: incident.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('retry-incident-' ~ incident.id) }}"><button class="inline-flex min-h-11 items-center border border-line px-3 text-accent hover:border-accent hover:bg-accent-soft">{{ "Retester le flux"|trans }}</button></form>{% include 'admin/_feed_retry_dialog.html.twig' with {incident: incident} %}<form method="post" action="{{ path('app_admin_incident_acknowledge', {id: incident.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('incident-' ~ incident.id) }}"><button class="inline-flex min-h-11 items-center border border-line px-3 text-accent hover:border-accent hover:bg-accent-soft">{{ "Acquitter"|trans }}</button></form>{% include 'admin/_delete_feed.html.twig' with {feed: incident.feed, scope: 'incident'} %}</div></li>{% endfor %}</ul></section>{% endif %}
 <section class="mt-12"><h2 class="font-serif text-3xl text-foreground">{{ "Comptes"|trans }}</h2><div class="mt-5 overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th>{{ "Compte"|trans }}</th><th>{{ "Actif"|trans }}</th><th>Admin</th><th>{{ "Quota"|trans }}</th><th></th></tr></thead><tbody>{% for user in users %}<tr><form method="post" action="{{ path('app_admin_user_update', {id: user.id}) }}"><td>{{ user.userIdentifier }}</td><td><input name="enabled" type="checkbox" value="1" {{ user.active ? 'checked' }}></td><td><input name="admin" type="checkbox" value="1" {{ user.admin ? 'checked' }}></td><td><label class="sr-only" for="quota-{{ user.id }}">{{ 'Limite d’abonnements de %name%'|trans({'%name%': user.userIdentifier}) }}</label><input id="quota-{{ user.id }}" class="w-20" name="subscription_limit" min="1" type="number" value="{{ user.subscriptionLimit }}" placeholder="∞"><span class="block text-xs text-muted">{{ '%count% / %limit% abonnements'|trans({'%count%': quotaCounts[user.id ~ ''], '%limit%': user.subscriptionLimit is null ? 'sans limite'|trans : user.subscriptionLimit}) }}</span><span class="block text-xs text-muted">{{ 'Vide : sans limite'|trans }}</span></td><td><input type="hidden" name="_token" value="{{ csrf_token('admin-user-' ~ user.id) }}"><button class="inline-flex items-center gap-2 text-accent hover:underline"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v6h9V3M7 21v-8h10v8"/></svg><span>{{ "Sauver"|trans }}</span></button></td></form></tr><tr><td colspan="5" class="pb-5 text-xs text-muted">{% if not user.active %}<form class="flex gap-2" method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"><input name="confirmation" placeholder="SUPPRIMER" aria-label="{{ 'Saisissez SUPPRIMER pour confirmer.'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}"><button class="inline-flex items-center gap-2 text-danger hover:underline"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg><span>{{ "Supprimer définitivement"|trans }}</span></button></form>{% else %}{{ 'Désactivez d’abord ce compte avant une suppression définitive.'|trans }}{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
</main>
<script type="module" src="{{ asset('controllers/confirm-feed-delete.js') }}"></script>
<script type="module" src="{{ asset('controllers/feed-retry.js') }}"></script>
{% endblock %}
