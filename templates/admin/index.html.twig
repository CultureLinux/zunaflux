{% extends 'base.html.twig' %}
{% block title %}Administration · Zunaflux{% endblock %}
{% block body %}
<main class="mx-auto min-h-screen max-w-6xl px-6 py-16">
 <p class="font-mono text-xs uppercase tracking-[.25em] text-orange-300">Administration</p><h1 class="mt-4 font-serif text-5xl text-white">Comptes & santé</h1>
 <p class="mt-4 text-slate-400">{{ users|length }} comptes · {{ subscriptionCount }} abonnements · {{ feedCount }} flux partagés</p>
 {% for message in app.flashes('success') %}<p class="mt-6 border border-emerald-400/40 p-3 text-emerald-200">{{ message }}</p>{% endfor %}
 {% for message in app.flashes('error') %}<p class="mt-6 border border-rose-400/40 p-3 text-rose-200">{{ message }}</p>{% endfor %}
 <section class="mt-10"><h2 class="font-serif text-3xl text-white">Incidents ouverts</h2>{% if incidents is empty %}<p class="mt-3 text-emerald-300">Aucun incident ouvert.</p>{% else %}<ul class="mt-4 divide-y divide-rose-900 border-y border-rose-900">{% for incident in incidents %}<li class="flex items-center justify-between gap-4 py-3"><p class="text-rose-200">{{ incident.feed.title ?: incident.feed.canonicalUrl }} — {{ incident.message }} ({{ incident.occurrences }})</p><form method="post" action="{{ path('app_admin_incident_acknowledge', {id: incident.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('incident-' ~ incident.id) }}"><button class="border border-rose-400 px-3 py-1 text-rose-200">Acquitter</button></form></li>{% endfor %}</ul>{% endif %}</section>
 <section class="mt-12"><h2 class="font-serif text-3xl text-white">Comptes</h2><div class="mt-5 overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th>Compte</th><th>Actif</th><th>Admin</th><th>Quota</th><th></th></tr></thead><tbody>{% for user in users %}<tr><form method="post" action="{{ path('app_admin_user_update', {id: user.id}) }}"><td>{{ user.userIdentifier }}</td><td><input name="enabled" type="checkbox" value="1" {{ user.active ? 'checked' }}></td><td><input name="admin" type="checkbox" value="1" {{ user.admin ? 'checked' }}></td><td><input class="w-20" name="subscription_limit" min="1" type="number" value="{{ user.subscriptionLimit }}"></td><td><input type="hidden" name="_token" value="{{ csrf_token('admin-user-' ~ user.id) }}"><button class="text-cyan-200">Sauver</button></td></form></tr>{% endfor %}</tbody></table></div></section>
 <section class="mt-12"><h2 class="font-serif text-3xl text-white">Comptes</h2><div class="mt-5 overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th>Compte</th><th>Actif</th><th>Admin</th><th>Quota</th><th></th></tr></thead><tbody>{% for user in users %}<tr><form method="post" action="{{ path('app_admin_user_update', {id: user.id}) }}"><td>{{ user.userIdentifier }}</td><td><input name="enabled" type="checkbox" value="1" {{ user.active ? 'checked' }}></td><td><input name="admin" type="checkbox" value="1" {{ user.admin ? 'checked' }}></td><td><input class="w-20" name="subscription_limit" min="1" type="number" value="{{ user.subscriptionLimit }}"></td><td><input type="hidden" name="_token" value="{{ csrf_token('admin-user-' ~ user.id) }}"><button class="text-cyan-200">Sauver</button></td></form></tr><tr><td colspan="5" class="pb-5 text-xs text-slate-500">{% if not user.active %}<form class="flex gap-2" method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"><input name="confirmation" placeholder="SUPPRIMER" aria-label="Confirmation de suppression"><input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}"><button class="text-rose-300">Supprimer définitivement</button></form>{% else %}Désactivez d’abord ce compte avant une suppression définitive.{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
</main>
{% endblock %}
