<p class="mt-1 text-sm text-muted">
    Première erreur : <time datetime="{{ incident.firstOccurredAt|date('c') }}">{{ incident.firstOccurredAt|date('d/m/Y à H:i', incidentTimezone) }}</time>
    {% if incident.occurrences > 1 %}
        · Dernière erreur : <time datetime="{{ incident.lastOccurredAt|date('c') }}">{{ incident.lastOccurredAt|date('d/m/Y à H:i', incidentTimezone) }}</time>
    {% endif %}
</p>
