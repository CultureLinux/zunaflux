<!DOCTYPE html>
<html lang="fr" data-theme="{{ user_theme(app.user) }}" data-accent="{{ user_accent(app.user) }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <meta name="theme-color" content="#1F2937">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <title>{% block title %}Zunaflux{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
    </head>
    <body class="bg-background text-foreground antialiased">
        {% if app.user %}
            {% set current_route = app.request.attributes.get('_route')|default('') %}
            <nav class="relative z-50 border-b border-line bg-background px-4 py-3 md:px-6" aria-label="Navigation principale">
                <div class="site-header flex flex-wrap items-center justify-between gap-3">
                    <a class="site-header-brand inline-flex items-center font-serif text-2xl text-foreground hover:text-accent" href="{{ path('app_articles') }}"><img class="site-header-logo" src="{{ asset('images/livre-rss-transparent.png') }}" alt="" width="54" height="40">Zunaflux</a>
                    <div class="site-header-links hidden flex-1 items-center gap-1 text-sm md:flex">{% include '_navigation_links.html.twig' %}</div>
                    <div class="hidden items-center gap-3 md:flex"><p class="max-w-48 truncate text-xs text-muted" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</p><form action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="border border-line px-3 py-2 text-xs font-semibold uppercase tracking-[.12em] text-foreground hover:border-warning hover:text-warning" type="submit">Quitter</button></form></div>
                    {% if current_route == 'app_articles' %}<button class="zen-open ml-auto inline-flex min-h-11 items-center justify-center text-accent md:hidden" type="button" data-zen-open aria-label="Ouvrir le mode zen"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16v12H4zM8 3v3m8-3v3M8 21v-3m8 3v-3"/></svg><span class="zen-count" data-zen-count aria-live="polite">…</span></button>{% else %}<a class="zen-open ml-auto inline-flex min-h-11 items-center justify-center text-accent md:hidden" href="{{ path('app_articles', {zen: 1}) }}" aria-label="Ouvrir le mode zen"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16v12H4zM8 3v3m8-3v3M8 21v-3m8 3v-3"/></svg></a>{% endif %}
                    <details class="relative md:hidden">
                        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-line px-4 text-sm text-foreground"><svg aria-hidden="true" class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16M4 12h16M4 18h16"/></svg>Menu</summary>
                        <div class="absolute right-0 z-50 mt-2 w-64 max-w-[calc(100vw-2rem)] border border-line bg-surface p-3 shadow-lg">
                            <div class="grid gap-1 text-sm">{% include '_navigation_links.html.twig' %}</div>
                            <p class="mt-3 truncate border-t border-line px-3 pt-3 text-xs text-muted" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</p>
                            <form class="mt-2" action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="w-full border border-line px-3 py-2 text-left text-xs font-semibold uppercase tracking-[.12em] text-foreground hover:border-warning hover:text-warning" type="submit">Quitter</button></form>
                        </div>
                    </details>
                </div>
            </nav>
        {% endif %}
        <aside class="mx-auto mt-4 max-w-6xl border border-line bg-surface p-4" data-pwa-install hidden aria-label="Installer Zunaflux">
            <p class="font-semibold">Installer Zunaflux sur votre écran d’accueil</p>
            <p class="mt-1 text-sm text-muted" data-pwa-install-help>Retrouvez votre lecteur parmi vos applications.</p>
            <div class="mt-3 flex flex-wrap gap-3"><button class="min-h-11 border border-accent px-4 text-accent" type="button" data-pwa-install-action>Installer</button><button class="min-h-11 px-4 text-muted" type="button" data-pwa-install-dismiss>Plus tard</button></div>
        </aside>
        <script src="{{ asset('install-pwa.js') }}" defer></script>
        <div class="toast-stack" data-toast-stack aria-live="polite" aria-atomic="false">
            {% for type, messages in app.flashes %}
                {% for message in messages %}<div class="toast toast--{{ type == 'error' ? 'error' : 'success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}<button type="button" data-toast-close aria-label="Fermer">×</button></div>{% endfor %}
            {% endfor %}
        </div>
        <script src="{{ asset('toast.js') }}" defer></script>
        {% block body %}{% endblock %}
    </body>
</html>
