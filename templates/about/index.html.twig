{% extends 'base.html.twig' %}
{% block title %}{{ "À propos"|trans }} · Zunaflux{% endblock %}
{% block body %}
<main class="mx-auto min-h-screen max-w-4xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[.25em] text-muted">{{ "À propos"|trans }}</p>
    <div class="mt-6 flex flex-wrap items-center gap-6"><img src="{{ asset('images/livre-rss-transparent.png') }}" alt="" class="h-24 w-32 object-contain"><div><h1 class="font-serif text-5xl text-foreground">Zunaflux</h1><p class="mt-2 text-muted">{{ "Votre lecteur RSS, à votre rythme."|trans }}</p></div></div>
    <section class="mt-12 border-y border-line py-6" aria-labelledby="about-version"><h2 id="about-version" class="font-serif text-2xl">Version</h2><p class="mt-2 text-muted">{{ "Version non renseignée"|trans }}</p></section>
    <section class="mt-8 grid gap-6 sm:grid-cols-2"><div><h2 class="font-serif text-2xl">{{ "Code source"|trans }}</h2><p class="mt-2 text-muted">{{ 'Découvrez le projet et son code sur GitHub.'|trans }}</p><a class="mt-3 inline-flex min-h-11 items-center gap-2 text-accent underline" href="https://github.com/CultureLinux/zunaflux" rel="noopener noreferrer"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z"/></svg><span>{{ "Voir le dépôt GitHub"|trans }}</span></a></div><div><h2 class="font-serif text-2xl">{{ "Soutenir le projet"|trans }}</h2><p class="mt-2 text-muted">{{ 'Vous pouvez soutenir CultureLinux sur Ko-fi.'|trans }}</p><a class="mt-3 inline-flex min-h-11 items-center gap-2 text-accent underline" href="https://ko-fi.com/culturelinux" rel="noopener noreferrer"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h15v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V6Zm15 2h1a3 3 0 0 1 0 6h-1M5 22h12"/><path d="M10.5 15.5 8 13c-1.4-1.5.7-3.5 2-2.2l.5.5.5-.5c1.3-1.3 3.4.7 2 2.2l-2.5 2.5Z" fill="currentColor" stroke="none"/></svg><span>{{ "Soutenir sur Ko-fi"|trans }}</span></a><div class="mt-3"><script type="text/javascript" src="https://storage.ko-fi.com/cdn/widget/Widget_2.js"></script><script type="text/javascript">kofiwidget2.init('Donate', '#72a4f2', 'E1E31E9X8Y');kofiwidget2.draw();</script></div></div></section>
    <section class="mt-8 border-t border-line pt-6" aria-labelledby="about-issue"><h2 id="about-issue" class="font-serif text-2xl">{{ "Signaler un problème"|trans }}</h2><p class="mt-2 text-muted">{{ 'Vous avez rencontré un bug ou souhaitez proposer une amélioration ?'|trans }}</p><a class="mt-3 inline-flex min-h-11 items-center gap-2 text-accent underline" href="https://github.com/CultureLinux/zunaflux/issues" rel="noopener noreferrer" target="_blank"><svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4m0 4h.01"/><path d="M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><span>{{ "Ouvrir une issue GitHub"|trans }}</span></a></section>
    <section class="mt-8 border-t border-line pt-6"><h2 class="font-serif text-2xl">{{ "Contact"|trans }}</h2><p class="mt-2 text-muted">{{ 'Une question ou un retour sur Zunaflux ?'|trans }}</p><a class="mt-3 inline-flex min-h-11 items-center text-accent underline" href="{{ path('app_contact') }}">{{ "Nous écrire"|trans }}</a></section>
</main>
{% endblock %}
