{% extends 'base.html.twig' %}
{% block title %}Contact · Zunaflux{% endblock %}
{% block body %}
<main class="mx-auto min-h-screen max-w-2xl px-4 py-12 sm:px-6 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-[.25em] text-muted">Zunaflux</p><h1 class="mt-3 font-serif text-4xl text-foreground sm:text-5xl">Nous contacter</h1><p class="mt-4 max-w-xl leading-7 text-muted">Une question ou un retour ? Écrivez-nous, nous répondrons à l’adresse indiquée.</p>
    {% if errors.form|default %}<div class="mt-8 border-l-4 border-danger bg-surface p-4 text-sm" role="alert">{{ errors.form }}</div>{% endif %}
    <form class="mt-10 grid gap-6 border border-line bg-surface p-5 shadow-sm sm:p-8" action="{{ path('app_contact') }}" method="post" novalidate><input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
        {% for field, label in {name: 'Nom', email: 'Adresse e-mail', subject: 'Sujet'} %}<div><label class="block text-sm font-semibold" for="contact-{{ field }}">{{ label }}</label><input class="mt-2 min-h-11 w-full border {{ errors[field]|default ? 'border-danger' : 'border-line' }} bg-background px-3" id="contact-{{ field }}" name="{{ field }}" type="{{ field == 'email' ? 'email' : 'text' }}" {% if field == 'name' %}autocomplete="name" maxlength="100"{% elseif field == 'email' %}autocomplete="email" maxlength="254"{% else %}maxlength="160"{% endif %} required value="{{ attribute(data, field)|default }}" aria-describedby="{{ errors[field]|default ? 'contact-' ~ field ~ '-error' : '' }}">{% if errors[field]|default %}<p class="mt-2 text-sm text-danger" id="contact-{{ field }}-error">{{ errors[field] }}</p>{% endif %}</div>{% endfor %}
        <div><label class="block text-sm font-semibold" for="contact-message">Message</label><textarea class="mt-2 min-h-40 w-full border {{ errors.message|default ? 'border-danger' : 'border-line' }} bg-background px-3 py-2" id="contact-message" name="message" minlength="10" maxlength="5000" required aria-describedby="contact-message-help {{ errors.message|default ? 'contact-message-error' : '' }}">{{ data.message|default }}</textarea><p class="mt-2 text-sm text-muted" id="contact-message-help">10 à 5 000 caractères. N’ajoutez pas d’informations sensibles.</p>{% if errors.message|default %}<p class="mt-2 text-sm text-danger" id="contact-message-error">{{ errors.message }}</p>{% endif %}</div>
        <button class="inline-flex min-h-11 items-center justify-center border border-accent bg-accent px-5 text-sm font-semibold text-accent-foreground hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" type="submit">Envoyer le message</button>
    </form>
</main>
{% endblock %}
