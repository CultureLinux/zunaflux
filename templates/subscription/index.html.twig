{% extends 'base.html.twig' %}

{% block title %}{{ "Abonnements"|trans }} · Zunaflux{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen max-w-[96rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
        <h1 class="font-serif text-5xl text-foreground">{{ "Vos abonnements"|trans }}</h1>

        <div class="mobile-subscription-actions" data-mobile-subscription-actions hidden>
            <button type="button" data-open-delete="mobile-add-feed" aria-label="{{ 'Ajouter ou chercher un flux'|trans }}" title="{{ 'Ajouter ou chercher un flux'|trans }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span>{{ "Ajouter"|trans }}</span></button>
            <button type="button" data-open-delete="mobile-import-feed" aria-label="{{ "Importer un fichier OPML"|trans }}" title="{{ "Importer un fichier OPML"|trans }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"/></svg><span>{{ "Importer"|trans }}</span></button>
        </div>
        <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <form class="grid min-w-0 gap-4 border border-line bg-surface p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_feed_discovery_start') }}" method="post" data-mobile-move="add" data-discovery-form data-live-url="{{ path('app_feed_discovery_live') }}">
            <div><label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="site_url">{{ 'Découvrir les flux d’un site'|trans }}</label><input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground" id="site_url" name="site_url" type="url" required placeholder="https://example.com/"></div>
            <input type="hidden" name="_token" value="{{ csrf_token('discover-feed') }}">
            <button class="self-end border border-line px-5 py-3 font-semibold text-foreground" type="submit">{{ "Chercher les flux"|trans }}</button>
        </form>
        <form class="grid min-w-0 gap-4 border border-line bg-surface p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_subscriptions') }}" method="post" data-mobile-move="add">
            <div>
                <label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="feed_url">{{ "Adresse du flux RSS ou Atom"|trans }}</label>
                <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="feed_url" name="feed_url" type="url" required placeholder="https://example.test/feed.xml">
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('subscribe-feed') }}">
            <input type="hidden" name="intent" value="subscribe-feed">
            <label class="grid gap-2 text-sm" for="direct-category">{{ 'Catégorie'|trans }}
                <select id="direct-category" name="discovery_category" data-direct-category class="w-full border border-line bg-background px-3 py-2">
                    <option value="none">{{ "Sans catégorie"|trans }}</option>
                    {% for category in categories %}<option value="{{ category.id }}">{{ category.name }}</option>{% endfor %}
                    <option value="new">{{ "Créer une catégorie"|trans }}</option>
                </select>
            </label>
            <label class="grid gap-2 text-sm" data-direct-new-category hidden>{{ "Nom de la nouvelle catégorie"|trans }}<input class="w-full border border-line bg-background px-3 py-2" name="new_category" maxlength="100" data-direct-category-name></label>
            <button class="self-end border border-accent bg-accent px-5 py-3 font-semibold text-accent-foreground hover:bg-accent" type="submit">{{ "Ajouter le flux"|trans }}</button>
        </form>

        <form class="grid min-w-0 gap-4 border border-dashed border-line p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_subscriptions') }}" method="post" enctype="multipart/form-data" data-mobile-move="import">
            <div>
                <label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="opml_file">{{ "Importer un fichier OPML"|trans }}</label>
                <p class="mt-2 text-sm text-muted">{{ 'Compatible FreshRSS. Les dossiers deviennent des catégories ; les abonnements déjà présents sont conservés.'|trans }}</p>
                <input class="mt-3 block w-full text-sm text-foreground file:mr-4 file:border-0 file:bg-surface-muted file:px-4 file:py-2 file:text-foreground hover:file:bg-surface-muted" id="opml_file" name="opml_file" type="file" accept=".opml,application/xml,text/xml" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('import-opml') }}">
            <input type="hidden" name="intent" value="import-opml">
            <button class="self-end border border-line px-5 py-3 font-semibold text-foreground hover:border-accent hover:text-accent" type="submit">{{ "Importer OPML"|trans }}</button>
        </form>
        <div class="min-w-0 border border-line bg-surface p-6">
            <label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="category-search">{{ 'Filtrer les catégories et les flux'|trans }}</label>
            <div class="mt-2 flex flex-wrap gap-2">
                <input class="min-w-0 flex-1 border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="category-search" type="search" placeholder="{{ 'Rechercher une catégorie, un flux ou une adresse'|trans }}" data-category-search>
                <button class="border border-line px-4 py-3 text-foreground hover:border-accent hover:text-accent" type="button" data-category-search-reset>{{ "Effacer"|trans }}</button>
            </div>
        </div>
        </div>

        <section class="mt-12" aria-labelledby="subscriptions-heading">
            <div class="flex items-center gap-3">
                <h2 class="font-serif text-2xl text-foreground" id="subscriptions-heading">{{ "Sources suivies"|trans }}</h2>
            </div>
            {% if subscriptions is empty and categories is empty %}
                <p class="mt-4 text-muted">{{ "Aucune source pour le moment."|trans }}</p>
            {% else %}
                <div class="subscription-groups mt-6">
                {% for category in categories %}
                    {% set categorySubscriptions = subscriptions|filter(subscription => subscription.category and subscription.category.id == category.id) %}
                        <section data-category-item="{{ category.name }}" data-drop-category="{{ category.id }}" class="min-w-0" aria-labelledby="source-category-{{ category.id }}">
                            <div class="flex items-center justify-between gap-2 border-b border-line pb-2">
                                <h3 class="min-w-0 break-words font-serif text-xl text-foreground" id="source-category-{{ category.id }}">{{ category.name }} <span class="ml-2 font-mono text-xs text-muted">{{ categorySubscriptions|length }}</span></h3>
                                <div class="flex shrink-0 items-center"><form method="post" action="{{ path('app_category_refresh_start', {id: category.id}) }}" data-category-refresh-form data-subscription-refresh-dialog="refresh-category-{{ category.id }}" data-status-url="{{ path('app_category_refresh_status', {id: category.id, runId: '__run_id__'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('category-refresh-' ~ category.id) }}"><button class="flex h-11 w-11 items-center justify-center text-muted hover:text-accent" type="submit" aria-label="{{ 'Rafraîchir la catégorie %name%'|trans({'%name%': category.name}) }}" title="{{ 'Rafraîchir cette catégorie'|trans }}"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-15.62 6M3 12a9 9 0 0 1 15.62-6M18 3v4h-4M6 21v-4h4"/></svg></button></form>
                                    <button class="flex h-11 w-11 items-center justify-center text-muted hover:text-accent" type="button" data-open-delete="edit-category-{{ category.id }}" aria-label="{{ 'Modifier la catégorie %name%'|trans({'%name%': category.name}) }}" title="{{ 'Modifier'|trans }}"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button>
                                    <button class="flex h-11 w-11 items-center justify-center text-danger" type="button" data-open-delete="delete-category-{{ category.id }}" aria-label="{{ 'Supprimer la catégorie %name%'|trans({'%name%': category.name}) }}" title="{{ "Supprimer"|trans }}"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>
                                </div>
                            </div>
                            <dialog id="edit-category-{{ category.id }}" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="edit-category-title-{{ category.id }}">
                                <h4 class="font-serif text-2xl" id="edit-category-title-{{ category.id }}">{{ "Modifier la catégorie"|trans }}</h4>
                                <form class="mt-4 grid gap-4" method="post" action="{{ path('app_category_update', {id: category.id}) }}">
                                    <label class="grid gap-2" for="edit-name-{{ category.id }}">{{ "Nom de la catégorie"|trans }}<input id="edit-name-{{ category.id }}" name="category_name" value="{{ category.name }}" maxlength="100" required class="border border-line bg-background px-4 py-3"></label>
                                    <input type="hidden" name="_token" value="{{ csrf_token('update-category-' ~ category.id) }}">
                                    <button class="border border-accent px-4 py-3 text-accent" type="submit">{{ "Enregistrer"|trans }}</button>
                                </form>
                                <form method="dialog" class="mt-3"><button class="border border-line px-4 py-3" type="submit">{{ "Annuler"|trans }}</button></form>
                            </dialog>
                            <dialog id="delete-category-{{ category.id }}" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="delete-category-title-{{ category.id }}">
                                <h4 class="font-serif text-2xl" id="delete-category-title-{{ category.id }}">{{ 'Supprimer %name% ?'|trans({'%name%': category.name}) }}</h4>
                                <p class="mt-4 text-muted">{{ 'Attention : cette action supprime vos %count% abonnement(s) de cette catégorie et leurs états de lecture, favoris et articles à lire plus tard. Les autres utilisateurs conservent leurs flux et leurs données.'|trans({'%count%': categorySubscriptions|length}) }}</p>
                                <div class="mt-4 flex flex-wrap gap-3"><form method="dialog"><button class="border border-line px-4 py-3" type="submit">{{ "Annuler"|trans }}</button></form><form method="post" action="{{ path('app_category_delete', {id: category.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}"><button class="border border-danger px-4 py-3 text-danger" type="submit">{{ 'Supprimer la catégorie et ses flux'|trans }}</button></form></div>
                            </dialog>
                            <dialog id="refresh-category-{{ category.id }}" class="discovery-dialog" data-subscription-refresh-dialog data-queued="{{ 'Mise en file…'|trans }}" data-pending="{{ 'En attente du worker'|trans }}" data-running="{{ 'Collecte en cours'|trans }}" data-collected="{{ 'Article(s) ajouté(s)'|trans }}" data-empty="{{ 'Aucun nouvel article'|trans }}" data-error="{{ 'Erreur'|trans }}" data-new-articles="{{ '%count% nouvel(s) article(s)'|trans }}" data-network-error="{{ 'Impossible de joindre le serveur pour lancer ou suivre la synchronisation.'|trans }}" aria-labelledby="refresh-category-title-{{ category.id }}"><h4 class="font-serif text-2xl" id="refresh-category-title-{{ category.id }}">{{ 'Rafraîchissement de la catégorie'|trans }}</h4><pre class="mt-4 max-h-96 overflow-auto whitespace-pre-wrap text-sm" data-subscription-refresh-log role="status" aria-live="polite">{{ 'Préparation…'|trans }}</pre><button class="mt-4 min-h-11 border border-line px-4" type="button" data-subscription-refresh-close>{{ 'Fermer'|trans }}</button></dialog>
                            {% include 'subscription/_source_list.html.twig' with {items: categorySubscriptions} %}
                        </section>
                {% endfor %}
                {% set uncategorizedSubscriptions = subscriptions|filter(subscription => subscription.category is null) %}
                {% if uncategorizedSubscriptions is not empty or categories is not empty %}
                    <section data-category-item="{{ 'Sans catégorie'|trans }}" data-drop-category="" class="min-w-0" aria-labelledby="source-uncategorized">
                        <h3 class="border-b border-line pb-3 font-serif text-xl text-foreground" id="source-uncategorized">{{ "Sans catégorie"|trans }} <span class="ml-2 font-mono text-xs text-muted">{{ uncategorizedSubscriptions|length }}</span></h3>
                        {% include 'subscription/_source_list.html.twig' with {items: uncategorizedSubscriptions} %}
                    </section>
                {% endif %}
                </div>
            {% endif %}
        </section>
    </main>
    <dialog id="mobile-add-feed" class="discovery-dialog" aria-labelledby="mobile-add-title">
        <h2 id="mobile-add-title" class="font-serif text-2xl">{{ "Ajouter un flux"|trans }}</h2>
        <div class="mobile-dialog-content" data-mobile-slot="add"></div>
        <form method="dialog" class="mt-4"><button class="border border-line px-4 py-2" type="submit">{{ "Fermer"|trans }}</button></form>
    </dialog>
    <dialog id="mobile-import-feed" class="discovery-dialog" aria-labelledby="mobile-import-title">
        <h2 id="mobile-import-title" class="font-serif text-2xl">{{ "Importer des flux"|trans }}</h2>
        <div class="mobile-dialog-content" data-mobile-slot="import"></div>
        <form method="dialog" class="mt-4"><button class="border border-line px-4 py-2" type="submit">{{ "Fermer"|trans }}</button></form>
    </dialog>
    <dialog class="discovery-dialog" data-discovery-dialog aria-labelledby="discovery-title"
        data-messages="{{ {
            loading: 'Chargement de la page et analyse de ses flux…'|trans,
            unexpected: 'Réponse inattendue du serveur (HTTP %status%). Consultez les journaux du serveur.'|trans,
            failed: 'La recherche a échoué.'|trans,
            empty: 'Aucun flux RSS ou Atom déclaré sur cette page.'|trans,
            found: '%count% flux trouvé(s). Choisissez celui à ajouter.'|trans,
            completed: 'Recherche des flux terminée.'|trans
        }|json_encode|e('html_attr') }}">
        <h2 id="discovery-title" class="font-serif text-2xl">{{ "Découverte des flux"|trans }}</h2>
        <div class="discovery-progress mt-4" data-discovery-progress hidden aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="mt-4 text-muted" data-discovery-status role="status" aria-live="polite"></p>
        <p class="mt-2 text-sm text-muted">{{ 'Recherche des déclarations RSS et Atom dans la page indiquée.'|trans }}</p>
        <div class="mt-4 text-sm" data-discovery-manual hidden>
            <p>{{ 'Ouvrez le site pour y chercher son adresse RSS ou Atom, puis copiez-la dans « Adresse du flux RSS ou Atom ».'|trans }}</p>
            <a class="mt-2 inline-block text-accent underline" data-discovery-manual-link target="_blank" rel="noopener noreferrer">{{ 'Ouvrir le site dans un nouvel onglet'|trans }}</a>
        </div>
        <form class="mt-4 grid gap-3" action="{{ path('app_subscriptions') }}" method="post" data-discovery-results hidden>
            <div class="grid gap-2" data-discovery-options></div>
            <label class="grid gap-2 text-sm" for="discovery-category">{{ 'Catégorie'|trans }}
                <select id="discovery-category" name="discovery_category" data-discovery-category class="w-full border border-line bg-background px-3 py-2">
                    <option value="none">{{ "Sans catégorie"|trans }}</option>
                    {% for category in categories %}<option value="{{ category.id }}">{{ category.name }}</option>{% endfor %}
                    <option value="new">{{ "Créer une catégorie"|trans }}</option>
                </select>
            </label>
            <label class="grid gap-2 text-sm" data-discovery-new-category hidden>{{ 'Nom de la nouvelle catégorie'|trans }}
                <input class="w-full border border-line bg-background px-3 py-2" name="new_category" maxlength="100" data-discovery-category-name>
            </label>
            <input type="hidden" name="intent" value="subscribe-feed">
            <input type="hidden" name="_token" value="{{ csrf_token('subscribe-feed') }}">
            <button class="justify-self-start border border-accent px-4 py-3 text-accent" type="submit">{{ "Ajouter ce flux"|trans }}</button>
        </form>
        <form method="dialog" class="mt-4"><button class="border border-line px-4 py-2" type="submit">{{ "Fermer"|trans }}</button></form>
    </dialog>
    <script type="module" src="{{ asset('controllers/subscription-page.js') }}"></script>
    <script type="module" src="{{ asset('controllers/subscription-refresh.js') }}"></script>
{% endblock %}
