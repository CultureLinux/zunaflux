{% extends 'base.html.twig' %}

{% block title %}Abonnements · Zunaflux{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen max-w-[96rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
        <h1 class="font-serif text-5xl text-foreground">Vos abonnements</h1>

        {% for message in app.flashes('success') %}
            <p class="mt-8 border border-success bg-surface-muted px-4 py-3 text-success" role="status">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <p class="mt-8 border border-danger bg-surface-muted px-4 py-3 text-danger" role="alert">{{ message }}</p>
        {% endfor %}

        <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <form class="grid min-w-0 gap-4 border border-line bg-surface p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_feed_discovery_start') }}" method="post">
            <div><label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="site_url">Découvrir les flux d’un site</label><input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground" id="site_url" name="site_url" type="url" required placeholder="https://example.com/"></div>
            <input type="hidden" name="_token" value="{{ csrf_token('discover-feed') }}">
            <button class="self-end border border-line px-5 py-3 font-semibold text-foreground" type="submit">Chercher les flux</button>
        </form>
        <form class="grid min-w-0 gap-4 border border-line bg-surface p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_subscriptions') }}" method="post">
            <div>
                <label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="feed_url">Adresse du flux RSS ou Atom</label>
                <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="feed_url" name="feed_url" type="url" required placeholder="https://example.test/feed.xml">
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('subscribe-feed') }}">
            <input type="hidden" name="intent" value="subscribe-feed">
            <button class="self-end border border-accent bg-accent px-5 py-3 font-semibold text-accent-foreground hover:bg-accent" type="submit">Ajouter le flux</button>
        </form>

        <form class="grid min-w-0 gap-4 border border-dashed border-line p-6 xl:grid-cols-[minmax(0,1fr)_auto]" action="{{ path('app_subscriptions') }}" method="post" enctype="multipart/form-data">
            <div>
                <label class="font-mono text-xs uppercase tracking-[.18em] text-muted" for="opml_file">Importer un fichier OPML</label>
                <p class="mt-2 text-sm text-muted">Compatible FreshRSS. Les dossiers deviennent des catégories ; les abonnements déjà présents sont conservés.</p>
                <input class="mt-3 block w-full text-sm text-foreground file:mr-4 file:border-0 file:bg-surface-muted file:px-4 file:py-2 file:text-foreground hover:file:bg-surface-muted" id="opml_file" name="opml_file" type="file" accept=".opml,application/xml,text/xml" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('import-opml') }}">
            <input type="hidden" name="intent" value="import-opml">
            <button class="self-end border border-line px-5 py-3 font-semibold text-foreground hover:border-accent hover:text-accent" type="submit">Importer OPML</button>
        </form>
        </div>

        <div class="mt-10"><label class="block text-sm text-muted" for="category-search">Filtrer les catégories</label><input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground" id="category-search" type="search" placeholder="Rechercher une catégorie" data-category-search></div>
        <section class="mt-12" aria-labelledby="subscriptions-heading">
            <div class="flex items-center gap-3">
                <h2 class="font-serif text-2xl text-foreground" id="subscriptions-heading">Sources suivies</h2>
                <button class="flex h-11 w-11 items-center justify-center border border-line text-accent hover:border-accent hover:bg-accent-soft" type="button" data-open-delete="create-category" aria-label="Ajouter une catégorie" title="Ajouter une catégorie"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
            <dialog id="create-category" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="create-category-title">
                <h3 class="font-serif text-2xl" id="create-category-title">Nouvelle catégorie</h3>
                <form class="mt-4 grid gap-4" action="{{ path('app_subscriptions') }}" method="post">
                    <label class="grid gap-2" for="category_name">Nom de la catégorie<input class="border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="category_name" name="category_name" required maxlength="100" autofocus></label>
                    <input type="hidden" name="_token" value="{{ csrf_token('create-category') }}">
                    <input type="hidden" name="intent" value="create-category">
                    <button class="border border-accent px-4 py-3 text-accent" type="submit">Créer la catégorie</button>
                </form>
                <form method="dialog" class="mt-3"><button class="border border-line px-4 py-3" type="submit">Annuler</button></form>
            </dialog>
            {% if subscriptions is empty and categories is empty %}
                <p class="mt-4 text-muted">Aucune source pour le moment.</p>
            {% else %}
                <div class="subscription-groups mt-6">
                {% for category in categories %}
                    {% set categorySubscriptions = subscriptions|filter(subscription => subscription.category and subscription.category.id == category.id) %}
                        <section data-category-item="{{ category.name }}" class="min-w-0" aria-labelledby="source-category-{{ category.id }}">
                            <div class="flex items-center justify-between gap-2 border-b border-line pb-2">
                                <h3 class="min-w-0 break-words font-serif text-xl text-foreground" id="source-category-{{ category.id }}">{{ category.name }} <span class="ml-2 font-mono text-xs text-muted">{{ categorySubscriptions|length }}</span></h3>
                                <div class="flex shrink-0 items-center">
                                    <button class="flex h-11 w-11 items-center justify-center text-muted hover:text-accent" type="button" data-open-delete="edit-category-{{ category.id }}" aria-label="Modifier la catégorie {{ category.name }}" title="Modifier"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button>
                                    <button class="flex h-11 w-11 items-center justify-center text-danger" type="button" data-open-delete="delete-category-{{ category.id }}" aria-label="Supprimer la catégorie {{ category.name }}" title="Supprimer"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>
                                </div>
                            </div>
                            <dialog id="edit-category-{{ category.id }}" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="edit-category-title-{{ category.id }}">
                                <h4 class="font-serif text-2xl" id="edit-category-title-{{ category.id }}">Modifier la catégorie</h4>
                                <form class="mt-4 grid gap-4" method="post" action="{{ path('app_category_update', {id: category.id}) }}">
                                    <label class="grid gap-2" for="edit-name-{{ category.id }}">Nom de la catégorie<input id="edit-name-{{ category.id }}" name="category_name" value="{{ category.name }}" maxlength="100" required class="border border-line bg-background px-4 py-3"></label>
                                    <input type="hidden" name="_token" value="{{ csrf_token('update-category-' ~ category.id) }}">
                                    <button class="border border-accent px-4 py-3 text-accent" type="submit">Enregistrer</button>
                                </form>
                                <form method="dialog" class="mt-3"><button class="border border-line px-4 py-3" type="submit">Annuler</button></form>
                            </dialog>
                            <dialog id="delete-category-{{ category.id }}" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="delete-category-title-{{ category.id }}">
                                <h4 class="font-serif text-2xl" id="delete-category-title-{{ category.id }}">Supprimer {{ category.name }} ?</h4>
                                <p class="mt-4 text-muted">Attention : cette action supprime vos {{ categorySubscriptions|length }} abonnement(s) de cette catégorie et leurs états de lecture, favoris et articles à lire plus tard. Les autres utilisateurs conservent leurs flux et leurs données.</p>
                                <div class="mt-4 flex flex-wrap gap-3"><form method="dialog"><button class="border border-line px-4 py-3" type="submit">Annuler</button></form><form method="post" action="{{ path('app_category_delete', {id: category.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}"><button class="border border-danger px-4 py-3 text-danger" type="submit">Supprimer la catégorie et ses flux</button></form></div>
                            </dialog>
                            {% include 'subscription/_source_list.html.twig' with {items: categorySubscriptions} %}
                        </section>
                {% endfor %}
                {% set uncategorizedSubscriptions = subscriptions|filter(subscription => subscription.category is null) %}
                {% if uncategorizedSubscriptions is not empty %}
                    <section data-category-item="Sans catégorie" class="min-w-0" aria-labelledby="source-uncategorized">
                        <h3 class="border-b border-line pb-3 font-serif text-xl text-foreground" id="source-uncategorized">Sans catégorie <span class="ml-2 font-mono text-xs text-muted">{{ uncategorizedSubscriptions|length }}</span></h3>
                        {% include 'subscription/_source_list.html.twig' with {items: uncategorizedSubscriptions} %}
                    </section>
                {% endif %}
                </div>
            {% endif %}
        </section>
    </main>
    <script type="module" src="{{ asset('controllers/subscription-page.js') }}"></script>
{% endblock %}
