<ul class="divide-y divide-line border-b border-line">
    {% for subscription in items %}
        <li class="min-w-0 py-2" data-subscription-item data-subscription-title="{{ subscription.displayTitle }}" data-feed-title="{{ subscription.feed.title|default('') }}" data-feed-url="{{ subscription.feed.canonicalUrl }}">
            <div class="flex min-h-11 items-center gap-2">
                    <span class="min-w-0 flex-1 break-words font-serif text-foreground">{{ subscription.displayTitle }}{% if not subscription.enabled %} <span class="font-sans text-xs text-muted">(inactif)</span>{% endif %}
                        {% set latest = latestPublications[subscription.id ~ '']|default(null) %}
                        {% if latest %}
                            {% set timestamp = latest|date('U') %}
                            {% if timestamp >= date('-1 day')|date('U') %}{% set age = 'day' %}{% set ageLabel = 'moins d’un jour' %}
                            {% elseif timestamp >= date('-1 week')|date('U') %}{% set age = 'week' %}{% set ageLabel = 'moins d’une semaine' %}
                            {% elseif timestamp >= date('-1 month')|date('U') %}{% set age = 'month' %}{% set ageLabel = 'moins d’un mois' %}
                            {% elseif timestamp >= date('-3 months')|date('U') %}{% set age = 'quarter' %}{% set ageLabel = 'moins de trois mois' %}
                            {% elseif timestamp >= date('-1 year')|date('U') %}{% set age = 'year' %}{% set ageLabel = 'plus de trois mois' %}
                            {% else %}{% set age = 'year' %}{% set ageLabel = 'plus d’un an' %}{% endif %}
                            <span class="feed-age block font-sans text-xs" data-feed-age="{{ age }}">Dernière publication : <time datetime="{{ latest|date('c') }}">{{ latest|date('d/m/Y') }}</time> · {{ ageLabel }}</span>
                        {% else %}<span class="block font-sans text-xs text-muted">Date de publication inconnue</span>{% endif %}
                    </span>
                    {% if subscription.feed.failureCount > 0 %}
                        <span class="flex min-h-11 items-center gap-1 text-warning" data-feed-incident title="Source indisponible : {{ subscription.feed.lastError }}">
                            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3h.01"/></svg>
                            <span class="text-xs">Indisponible</span>
                        </span>
                    {% endif %}
                    <button type="button" data-open-delete="edit-subscription-{{ subscription.id }}" class="flex h-11 w-11 shrink-0 items-center justify-center text-muted hover:text-accent" aria-label="Modifier {{ subscription.displayTitle }}" title="Modifier les paramètres">
                        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                        </button>
                </div>
                <dialog id="edit-subscription-{{ subscription.id }}" class="m-auto w-full max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="edit-subscription-title-{{ subscription.id }}">
                    <h3 class="font-serif text-2xl" id="edit-subscription-title-{{ subscription.id }}">Modifier {{ subscription.displayTitle }}</h3>
                    {% if subscription.feed.failureCount > 0 %}<p class="mb-3 text-sm text-warning">Source indisponible : {{ subscription.feed.lastError }}</p>{% endif %}
                    <a class="block break-all text-xs text-accent hover:underline" href="{{ subscription.feed.canonicalUrl }}" rel="noreferrer" target="_blank">{{ subscription.feed.canonicalUrl }}</a>
                    <form class="mt-4 grid gap-3" action="{{ path('app_subscription_update', {id: subscription.id}) }}" method="post">
                        <label class="grid gap-1 text-sm" for="url-{{ subscription.id }}">Adresse du flux RSS ou Atom
                            <input class="w-full min-w-0 border border-line bg-background px-3 py-2" id="url-{{ subscription.id }}" name="feed_url" type="url" value="{{ subscription.feed.canonicalUrl }}" maxlength="2048" required>
                        </label>
                        <label class="grid gap-1 text-sm" for="title-{{ subscription.id }}">Titre personnalisé
                            <input class="w-full min-w-0 border border-line bg-background px-3 py-2" id="title-{{ subscription.id }}" name="custom_title" value="{{ subscription.displayTitle }}" maxlength="255">
                        </label>
                        <label class="grid gap-1 text-sm" for="category-{{ subscription.id }}">Catégorie
                            <select class="w-full min-w-0 border border-line bg-background px-3 py-2" id="category-{{ subscription.id }}" name="category_id"><option value="">Sans catégorie</option>{% for category in categories %}<option value="{{ category.id }}" {{ subscription.category and subscription.category.id == category.id ? 'selected' }}>{{ category.name }}</option>{% endfor %}</select>
                        </label>
                        <div class="flex items-center justify-between gap-3">
                            <label class="flex min-h-11 items-center gap-2 text-sm"><input name="enabled" type="checkbox" value="1" {{ subscription.enabled ? 'checked' }}> Actif</label>
                            <input type="hidden" name="_token" value="{{ csrf_token('subscription-' ~ subscription.id) }}">
                            <button class="flex h-11 w-11 items-center justify-center border border-line text-foreground hover:border-accent hover:text-accent" type="submit" aria-label="Enregistrer les modifications de {{ subscription.displayTitle }}" title="Enregistrer">
                                <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v6h9V3M7 21v-8h10v8"/></svg>
                            </button>
                            <button class="min-h-11 border border-danger px-3 text-danger" type="button" data-open-delete="delete-{{ subscription.id }}" data-close-current-dialog>Supprimer</button>
                        </div>
                    </form>
                    <form method="dialog" class="mt-4"><button class="min-h-11 border border-line px-4" type="submit">Annuler</button></form>
                </dialog>
                    <dialog id="delete-{{ subscription.id }}" class="m-auto max-w-lg border border-line bg-surface p-6 text-foreground backdrop:bg-background/80" aria-labelledby="delete-title-{{ subscription.id }}">
                        <h3 class="font-serif text-xl" id="delete-title-{{ subscription.id }}">Retirer {{ subscription.displayTitle }} ?</h3>
                        <p class="mt-3 text-sm text-muted">Vos états de lecture, favoris et articles enregistrés pour cette source seront supprimés.</p>
                        <div class="mt-4 flex flex-wrap gap-3">
                            <form method="dialog"><button class="min-h-11 border border-line px-4" type="submit">Annuler</button></form>
                            <form data-delete-subscription action="{{ path('app_subscription_delete', {id: subscription.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-subscription-' ~ subscription.id) }}">
                                <button class="min-h-11 border border-danger px-4 text-danger" type="submit">Confirmer le retrait</button>
                            </form>
                        </div>
                    </dialog>
        </li>
    {% endfor %}
</ul>
