{% extends 'base.html.twig' %}

{% block title %}Lecture · Zunaflux{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen max-w-5xl px-6 py-12 {{ preference.density == 'compact' ? 'article-density-compact' : '' }} {{ preference.fontScale == 'large' ? 'text-lg' : preference.fontScale == 'small' ? 'text-sm' : '' }}" data-read-mode-default="{{ preference.readMode }}">
        <section class="pb-12"><p class="font-mono text-xs uppercase tracking-[.25em] text-muted">Votre lecture</p><h1 class="mt-4 font-serif text-5xl text-foreground">Les derniers articles</h1><p class="mt-4 text-muted">Votre liste se charge ici à partir de vos abonnements actifs.</p></section>
        <form class="mb-5 flex max-w-2xl flex-wrap gap-2" data-article-search>
            <label class="sr-only" for="article-search">Rechercher dans vos articles</label><input class="min-w-0 flex-1 border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="article-search" name="q" type="search" placeholder="Rechercher dans vos articles" value="{{ app.request.query.get('q') }}">
            <button class="border border-accent px-4 py-3 text-accent hover:bg-accent hover:text-accent-foreground" type="submit">Rechercher</button>
        </form>
        <section class="mb-5 flex flex-wrap gap-2" data-saved-filters data-csrf-token="{{ csrf_token('saved-filter') }}"><label class="sr-only" for="saved-filter">Filtres enregistrés</label><select class="border border-line bg-background px-3 py-2" id="saved-filter" data-saved-filter><option value="">Filtres enregistrés</option></select><button class="border border-line px-3 py-2 text-sm" data-save-filter type="button">Enregistrer cette recherche</button></section>
        <section class="mb-6 flex flex-wrap gap-3" data-article-actions data-csrf-token="{{ csrf_token('article-bulk') }}"><label class="flex items-center gap-2 text-sm text-foreground">Lecture <select class="border border-line bg-background px-2 py-1" data-read-mode><option value="on_preview">Marquer à l’ouverture</option><option value="manual">Manuel</option></select></label><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-read type="button">Marquer lus</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-unread type="button">Marquer non lus</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-favorite type="button">Ajouter aux favoris</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-unfavorite type="button">Retirer les favoris</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-save type="button">Lire plus tard</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-bulk-unsave type="button">Retirer de la liste</button><label class="flex items-center gap-2 text-sm text-foreground">Lus avant <input class="border border-line bg-background px-2 py-1" data-mark-before type="date"><button class="border border-line px-3 py-1 hover:border-accent" data-mark-before-submit type="button">Appliquer</button></label></section><section data-article-list="{{ path('app_api_articles') }}" aria-live="polite"><p class="border border-line bg-surface p-6 text-muted">Chargement des articles…</p></section><div data-article-sentinel aria-hidden="true"></div><button class="mt-6 border border-line px-5 py-3 text-sm text-foreground hover:border-accent" data-article-more hidden type="button">Charger les suivants</button>
    </main>
    <dialog class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto border border-line bg-surface p-0 text-foreground backdrop:bg-background/80" data-article-dialog aria-labelledby="article-dialog-title">
        <article class="p-6 md:p-10"><div class="flex items-start justify-between gap-6"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-accent" data-article-source></p><h2 class="mt-3 font-serif text-3xl text-foreground" id="article-dialog-title" data-article-title></h2></div><form method="dialog"><button class="border border-line px-3 py-2 text-sm text-foreground hover:border-accent" type="submit">Fermer</button></form></div><p class="mt-7 max-w-prose whitespace-pre-line font-serif text-lg leading-relaxed text-foreground" data-article-summary></p><div class="mt-8 flex flex-wrap gap-3"><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-article-previous type="button">Précédent</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-article-next type="button">Suivant</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-article-read type="button">Marquer lu</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-article-favorite type="button">Ajouter aux favoris</button><button class="border border-line px-4 py-2 text-sm text-foreground hover:border-accent" data-article-saved type="button">Lire plus tard</button><a class="bg-accent px-5 py-2 text-sm font-bold text-accent-foreground hover:bg-accent" data-article-link hidden rel="noreferrer" target="_blank">Ouvrir l’original</a></div></article>
    </dialog>
    <script type="module" src="{{ asset('controllers/article-list.js') }}"></script>
{% endblock %}
