{% extends 'base.html.twig' %}

{% block title %}Lecture · Zunaflux{% endblock %}

{% block body %}
    <div class="{{ preference.sidebarCollapsed ? 'reading-workspace' : '' }}">
        <header class="reading-search-header">
        <div class="reading-search-controls">
        <label class="sr-only" for="read-filter">Vue des articles</label><select class="border border-line bg-background px-3 py-2" id="read-filter" data-read-filter><option value="0">Non lus</option><option value="">Tous les articles</option><option value="1">Lus</option><option value="favorite">Favoris</option><option value="saved">À lire plus tard</option></select>
        <form class="flex min-w-0 flex-1 flex-wrap gap-2" data-article-search>
            <label class="sr-only" for="article-search">Rechercher dans vos articles</label><input class="min-w-0 flex-1 border border-line bg-background px-4 py-3 text-foreground outline-none focus:border-accent" id="article-search" name="q" type="search" placeholder="Rechercher dans vos articles" value="{{ app.request.query.get('q') }}">
            <button class="reading-search-button border border-accent px-4 py-3 text-accent hover:bg-accent hover:text-accent-foreground" type="submit" aria-label="Rechercher"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><span>Rechercher</span></button>
        </form>
        </div>
        </header>
        {% if preference.sidebarCollapsed %}
        <aside class="reading-sidebar" aria-label="Navigation de lecture">
            <p class="reading-sidebar-title">Votre lecture</p>

            <div class="reading-sidebar-heading"><p>Sources</p><a href="{{ path('app_subscriptions') }}" aria-label="Gérer les sources">+</a></div>
            <nav class="reading-sidebar-nav" aria-label="Vos sources">
                {% for subscription in readingSubscriptions %}
                    {% set counts = readingCounts[subscription.id ~ '']|default({unread: 0, read: 0}) %}
                    {% set currentRead = app.request.query.get('read', '0') %}
                    <div class="reading-source-row" data-reading-source data-unread="{{ counts.unread }}" data-read="{{ counts.read }}" {% if (currentRead == '0' and counts.unread == 0) or (currentRead == '1' and counts.read == 0) or (currentRead == '' and counts.unread + counts.read == 0) %}hidden{% endif %}>
                        <a data-source-link href="{{ path('app_articles', {subscription: subscription.id, read: currentRead}) }}" {% if app.request.query.get('subscription') == subscription.id ~ '' %}aria-current="page"{% endif %}><span>{{ subscription.displayTitle }} {% if subscription.feed.lastError %}<svg data-feed-warning class="inline h-4 w-4 text-warning" role="img" aria-label="Erreur de collecte" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3v1"/></svg>{% endif %}</span><span class="reading-unread-count" data-unread-subscription="{{ subscription.id }}" aria-label="{{ counts.unread }} articles non lus">{{ counts.unread }}</span></a>
                        <form method="post" action="{{ path('app_subscription_mark_read', {id: subscription.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('mark-feed-read-' ~ subscription.id) }}"><button type="submit" class="reading-mark-feed" title="Marquer tous les articles de {{ subscription.displayTitle }} comme lus" aria-label="Marquer tous les articles de {{ subscription.displayTitle }} comme lus">✓</button></form>
                    </div>
                {% else %}
                    <p class="text-sm text-muted">Aucune source active.</p>
                {% endfor %}
            </nav>
        </aside>
        {% endif %}
    <main class="mx-auto min-h-screen max-w-[96rem] px-4 py-12 sm:px-6 lg:px-8 {{ preference.density == 'compact' ? 'article-density-compact' : '' }} {{ preference.fontScale == 'large' ? 'text-lg' : preference.fontScale == 'small' ? 'text-sm' : '' }}" data-read-mode-default="{{ preference.readMode }}">
        <section class="reading-intro hidden pb-12 md:block"><p class="font-mono text-xs uppercase tracking-[.25em] text-muted">Votre lecture</p><h1 class="mt-4 font-serif text-5xl text-foreground">Les derniers articles</h1><p class="mt-4 text-muted">Votre liste se charge ici à partir de vos abonnements actifs.</p></section>
        <div class="mb-5 flex flex-wrap items-center gap-2">


        <section class="flex flex-wrap items-center gap-2" data-article-actions data-csrf-token="{{ csrf_token('article-bulk') }}" aria-label="Actions groupées">
            <button class="border border-line px-3 py-2 text-sm text-accent hover:border-accent hover:bg-accent-soft" data-select-all type="button" aria-pressed="false" hidden>Sélectionner les articles chargés</button>
            <span class="text-sm text-muted" data-selected-count aria-live="polite"></span>
            {% for action in [
                {key: 'read', label: 'Marquer lus', icon: 'M4 12l5 5L20 6'},
                {key: 'unread', label: 'Marquer non lus', icon: 'M4 6l16 12M4 18 20 6'},
                {key: 'favorite', label: 'Ajouter aux favoris', icon: 'm12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z'},
                {key: 'unfavorite', label: 'Retirer les favoris', icon: 'M4 4l16 16M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z'},
                {key: 'save', label: 'Lire plus tard', icon: 'M6 3h12v18l-6-4-6 4V3Z'},
                {key: 'unsave', label: 'Retirer de la liste', icon: 'M6 3h12v18l-6-4-6 4V3ZM9 10h6'}
            ] %}
                <button class="flex h-11 w-11 items-center justify-center border border-accent bg-accent-soft text-accent hover:bg-accent hover:text-accent-foreground" data-bulk-{{ action.key }} type="button" aria-label="{{ action.label }}" title="{{ action.label }}" disabled hidden><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="{{ action.icon }}"/></svg></button>
            {% endfor %}
        </section>
        </div>
        <div class="mb-4 flex items-center gap-3" data-source-filter hidden><span class="text-sm text-muted" data-source-filter-label></span><button class="border border-line px-3 py-2 text-sm text-accent hover:bg-accent-soft" type="button" data-clear-source>Voir tous les flux</button></div>
        <p class="mb-4 text-sm text-danger" data-bulk-error role="alert" hidden></p>
        <section data-article-list="{{ path('app_api_articles') }}" aria-live="polite"><p class="border border-line bg-surface p-6 text-muted">Chargement des articles…</p></section><div data-article-sentinel aria-hidden="true"></div><button class="mt-6 border border-line px-5 py-3 text-sm text-foreground hover:border-accent" data-article-more hidden type="button">Charger les suivants</button>
    </main>
    <dialog class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-5xl overflow-y-auto border border-line bg-surface p-0 text-foreground backdrop:bg-background/80" data-article-dialog aria-labelledby="article-dialog-title">
        <article class="p-6 md:p-10">
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                {% include 'article/_actions.html.twig' %}
                <form method="dialog"><button class="border border-line px-3 py-2 text-sm text-foreground hover:border-accent" type="submit"><span class="reading-back-label">Retour à la liste</span><span class="reading-close-label">Fermer</span></button></form>
            </div>
            <div><p class="font-mono text-xs uppercase tracking-[.2em] text-accent" data-article-source></p><h2 class="mt-3 font-serif text-3xl text-foreground" id="article-dialog-title" data-article-title></h2></div>
            <p class="mt-4 text-sm text-danger" data-article-error role="alert" hidden></p>
            <div class="article-prose mt-7 max-w-prose font-serif text-lg leading-relaxed text-foreground" data-article-summary></div>
            <div class="reading-actions-bottom mt-8">{% include 'article/_actions.html.twig' %}</div>
        </article>
    </dialog>
    </div>
    <dialog class="zen-dialog" data-zen-dialog aria-labelledby="zen-title">
        <div class="zen-header"><button type="button" data-zen-close aria-label="Fermer le mode zen">✕</button><span>Lecture zen <span data-zen-remaining aria-live="polite">…</span></span><button type="button" data-zen-help aria-label="Aide du mode zen">?</button></div>
        <div class="zen-content" data-zen-content>
            <p class="text-accent" data-zen-source></p><h2 class="mt-3 font-serif text-3xl" id="zen-title" data-zen-title>Lecture zen</h2>
            <p data-zen-message role="status" aria-live="polite"></p><div class="article-prose mt-7 font-serif text-lg leading-relaxed" data-zen-body></div>
        </div>
        <div class="zen-actions"><button type="button" data-zen-previous aria-label="Article précédent">←</button><button type="button" data-zen-favorite aria-label="Ajouter ou retirer des favoris">☆</button><button type="button" data-zen-save aria-label="Ajouter à lire plus tard">♧</button><button type="button" data-zen-next aria-label="Article suivant">→</button></div>
        <div class="zen-guide" data-zen-guide hidden><div><h3 class="font-serif text-2xl">Bienvenue en lecture zen</h3><p class="mt-4">Faites défiler l’article normalement. Glissez à gauche ou à droite sur l’article pour naviguer. Les boutons en bas permettent aussi de changer d’article, gérer les favoris et enregistrer pour plus tard.</p><button class="mt-5 border border-accent px-4 text-accent" type="button" data-zen-guide-close>J’ai compris</button></div></div>
    </dialog>
    <script type="module" src="{{ asset('controllers/article-list.js') }}"></script>
    <script type="module" src="{{ asset('controllers/zen.js') }}"></script>
{% endblock %}
