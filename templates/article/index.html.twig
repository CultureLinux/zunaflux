{% extends 'base.html.twig' %}

{% block title %}Lecture · Zunaflux{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen max-w-5xl px-6 py-12 {{ preference.density == 'compact' ? 'article-density-compact' : '' }} {{ preference.fontScale == 'large' ? 'text-lg' : preference.fontScale == 'small' ? 'text-sm' : '' }}" data-read-mode-default="{{ preference.readMode }}">
        <section class="pb-12"><p class="font-mono text-xs uppercase tracking-[.25em] text-orange-300">Votre lecture</p><h1 class="mt-4 font-serif text-5xl text-white">Les derniers articles</h1><p class="mt-4 text-slate-400">Votre liste se charge ici à partir de vos abonnements actifs.</p></section>
        <form class="mb-5 flex max-w-2xl gap-2" data-article-search>
            <label class="sr-only" for="article-search">Rechercher dans vos articles</label><input class="min-w-0 flex-1 border border-slate-600 bg-slate-950 px-4 py-3 text-slate-100 outline-none focus:border-cyan-300" id="article-search" name="q" type="search" placeholder="Rechercher dans vos articles" value="{{ app.request.query.get('q') }}">
            <button class="border border-cyan-300 px-4 py-3 text-cyan-200 hover:bg-cyan-300 hover:text-slate-950" type="submit">Rechercher</button>
        </form>
        <section class="mb-5 flex flex-wrap gap-2" data-saved-filters data-csrf-token="{{ csrf_token('saved-filter') }}"><label class="sr-only" for="saved-filter">Filtres enregistrés</label><select class="border border-slate-700 bg-slate-950 px-3 py-2" id="saved-filter" data-saved-filter><option value="">Filtres enregistrés</option></select><button class="border border-slate-600 px-3 py-2 text-sm" data-save-filter type="button">Enregistrer cette recherche</button></section>
        <section class="mb-6 flex flex-wrap gap-3" data-article-actions data-csrf-token="{{ csrf_token('article-bulk') }}"><label class="flex items-center gap-2 text-sm text-slate-300">Lecture <select class="border border-slate-600 bg-slate-950 px-2 py-1" data-read-mode><option value="on_preview">Marquer à l’ouverture</option><option value="manual">Manuel</option></select></label><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-read type="button">Marquer lus</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-unread type="button">Marquer non lus</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-favorite type="button">Ajouter aux favoris</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-unfavorite type="button">Retirer les favoris</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-save type="button">Lire plus tard</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-bulk-unsave type="button">Retirer de la liste</button><label class="flex items-center gap-2 text-sm text-slate-300">Lus avant <input class="border border-slate-600 bg-slate-950 px-2 py-1" data-mark-before type="date"><button class="border border-slate-600 px-3 py-1 hover:border-cyan-300" data-mark-before-submit type="button">Appliquer</button></label></section><section data-article-list="{{ path('app_api_articles') }}" aria-live="polite"><p class="border border-slate-800 bg-slate-900/60 p-6 text-slate-400">Chargement des articles…</p></section><div data-article-sentinel aria-hidden="true"></div><button class="mt-6 border border-slate-600 px-5 py-3 text-sm text-slate-200 hover:border-cyan-300" data-article-more hidden type="button">Charger les suivants</button>
    </main>
    <dialog class="m-auto w-full max-w-2xl border border-slate-700 bg-slate-900 p-0 text-slate-100 backdrop:bg-slate-950/80" data-article-dialog aria-labelledby="article-dialog-title">
        <article class="p-6 md:p-10"><div class="flex items-start justify-between gap-6"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-cyan-300" data-article-source></p><h2 class="mt-3 font-serif text-3xl text-white" id="article-dialog-title" data-article-title></h2></div><form method="dialog"><button class="border border-slate-600 px-3 py-2 text-sm text-slate-200 hover:border-cyan-300" type="submit">Fermer</button></form></div><p class="mt-7 whitespace-pre-line leading-7 text-slate-300" data-article-summary></p><div class="mt-8 flex flex-wrap gap-3"><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-article-previous type="button">Précédent</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-article-next type="button">Suivant</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-article-read type="button">Marquer lu</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-article-favorite type="button">Ajouter aux favoris</button><button class="border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:border-cyan-300" data-article-saved type="button">Lire plus tard</button><a class="bg-cyan-300 px-5 py-2 text-sm font-bold text-slate-950 hover:bg-cyan-200" data-article-link hidden rel="noreferrer" target="_blank">Ouvrir l’original</a></div></article>
    </dialog>
    <script type="module" src="{{ asset('controllers/article-list.js') }}"></script>
{% endblock %}
