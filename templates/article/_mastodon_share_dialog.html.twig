<dialog class="m-auto w-[calc(100%-2rem)] max-w-xl border border-line bg-surface p-6 text-foreground backdrop:bg-background/80 sm:p-8" data-mastodon-share-dialog aria-labelledby="mastodon-share-title" aria-describedby="mastodon-share-help">
    <form data-mastodon-share-form>
        <div class="flex items-start justify-between gap-4">
            <div><p class="font-mono text-xs uppercase tracking-[.2em] text-accent">Mastodon</p><h2 class="mt-2 font-serif text-2xl" id="mastodon-share-title">{{ 'Publier sur Mastodon'|trans }}</h2></div>
            <button class="flex h-11 w-11 shrink-0 items-center justify-center border border-line text-muted hover:border-accent hover:text-accent" type="button" data-mastodon-share-close aria-label="{{ 'Fermer'|trans }}" title="{{ 'Fermer'|trans }}"><svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <p class="mt-3 text-sm text-muted" id="mastodon-share-help">{{ 'Vérifiez et modifiez votre message avant publication.'|trans }}</p>
        <label class="mt-5 grid gap-2" for="mastodon-share-status"><span class="font-medium">{{ 'Message'|trans }}</span><textarea class="min-h-32 border border-line bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent" id="mastodon-share-status" data-mastodon-share-status maxlength="500" required></textarea><span class="text-sm text-muted" data-mastodon-share-count aria-live="polite"></span></label>
        <label class="mt-4 grid gap-2" for="mastodon-share-visibility"><span class="font-medium">{{ 'Visibilité'|trans }}</span><select class="min-h-11 border border-line bg-background px-3 text-foreground focus:border-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent" id="mastodon-share-visibility" data-mastodon-share-visibility><option value="public" selected>{{ 'Publique'|trans }}</option><option value="unlisted">{{ 'Non listée'|trans }}</option><option value="private">{{ 'Abonnés uniquement'|trans }}</option><option value="direct">{{ 'Directe'|trans }}</option></select></label>
        <p class="mt-2 text-sm text-muted" data-mastodon-share-direct-help hidden>{{ 'Un message direct doit mentionner au moins un destinataire, par exemple @nom@instance.'|trans }}</p>
        <p class="mt-4 text-sm text-danger" data-mastodon-share-error role="alert" hidden></p>
        <p class="mt-4 text-sm text-success" data-mastodon-share-success role="status" hidden><a class="underline decoration-accent underline-offset-4" data-mastodon-share-link target="_blank" rel="noopener noreferrer">{{ 'Voir la publication sur Mastodon'|trans }}</a></p>
        <div class="mt-6 flex flex-wrap justify-end gap-3"><button class="min-h-11 border border-line px-4 hover:border-accent" type="button" data-mastodon-share-cancel>{{ 'Annuler'|trans }}</button><button class="min-h-11 border border-accent bg-accent px-4 text-accent-foreground hover:bg-accent/90 disabled:cursor-not-allowed disabled:opacity-60" type="submit" data-mastodon-share-submit>{{ 'Publier'|trans }}</button></div>
    </form>
</dialog>
