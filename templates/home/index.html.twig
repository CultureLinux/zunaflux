{% extends 'base.html.twig' %}

{% block body %}
    <main id="main" tabindex="-1" class="relative isolate min-h-screen overflow-hidden px-6 py-8 md:px-12">
        {% if not app.user %}<header class="mx-auto flex max-w-6xl items-center justify-between border-b border-line pb-6"><p class="font-serif text-2xl text-foreground">Zunaflux</p><a class="text-sm font-semibold text-foreground transition hover:text-accent" href="{{ path('app_login') }}">{{ "Se connecter"|trans }}</a></header>{% endif %}
        <section class="mx-auto grid max-w-6xl gap-12 py-24 lg:grid-cols-[1.2fr_.8fr] lg:items-end lg:py-5">
            <div>
                <p class="font-mono text-xs uppercase tracking-[.26em] text-muted">{{ 'La salle de lecture, retrouvée'|trans }}</p>
                <h1 class="mt-6 max-w-3xl font-serif text-5xl leading-[.92] text-foreground sm:text-7xl">{{ 'Vos sources.'|trans }}<br>{{ 'Votre rythme.'|trans }}</h1>
                <p class="mt-7 max-w-xl text-lg leading-8 text-foreground">{{ 'Un lecteur RSS auto-hébergé pour retrouver l’essentiel, organiser votre veille et lire sans le vacarme.'|trans }}</p>
                <div class="mt-10 flex flex-wrap gap-4">{% if app.user %}<a class="bg-accent px-6 py-3 text-sm font-bold uppercase tracking-[.14em] text-accent-foreground transition hover:bg-accent" href="{{ path('app_articles') }}">{{ 'Ouvrir la lecture'|trans }}</a>{% elseif initial_setup_required %}<a class="bg-accent px-6 py-3 text-sm font-bold uppercase tracking-[.14em] text-accent-foreground transition hover:bg-accent" href="{{ path('app_setup') }}">{{ 'Configurer Zunaflux'|trans }}</a>{% else %}<a class="bg-accent px-6 py-3 text-sm font-bold uppercase tracking-[.14em] text-accent-foreground transition hover:bg-accent" href="{{ path('app_login') }}">{{ "Se connecter"|trans }}</a>{% endif %}</div>
            </div>
            <aside class="border-t border-line py-6" aria-label="{{ 'Principes de Zunaflux'|trans }}">
                <img class="mb-8 w-full" src="{{ asset('images/livre-rss-960.webp') }}" alt="" width="960" height="540" fetchpriority="high">
                <p class="font-mono text-xs uppercase tracking-[.2em] text-accent">{{ 'À retenir'|trans }}</p>
                <dl class="mt-7 space-y-6"><div><dt class="font-serif text-2xl text-foreground">{{ 'Vos sources'|trans }}</dt><dd class="mt-1 text-sm leading-6 text-muted">{{ 'RSS et Atom, choisis et organisés par vous.'|trans }}</dd></div><div><dt class="font-serif text-2xl text-foreground">{{ "Votre espace"|trans }}</dt><dd class="mt-1 text-sm leading-6 text-muted">{{ 'Une veille personnelle, loin des fils imposés.'|trans }}</dd></div><div><dt class="font-serif text-2xl text-foreground">{{ 'Votre attention'|trans }}</dt><dd class="mt-1 text-sm leading-6 text-muted">{{ 'Une interface calme pour mieux lire.'|trans }}</dd></div></dl>
            </aside>
        </section>
    </main>
{% endblock %}
