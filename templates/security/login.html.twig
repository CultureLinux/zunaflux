{% extends 'base.html.twig' %}

{% block title %}Connexion · Zunaflux{% endblock %}

{% block body %}
    <main class="relative isolate grid min-h-screen place-items-center overflow-hidden px-6 py-12">
        <section class="w-full max-w-md border border-line bg-surface p-8 md:p-10">
            <p class="mb-6 font-mono text-xs uppercase tracking-[.35em] text-accent">Zunaflux / lecteur personnel</p>
            <h1 class="font-serif text-4xl leading-none text-foreground">{{ "Bienvenue dans Zunaflux"|trans }}</h1>
            <p class="mt-4 text-sm leading-6 text-foreground">{{ "Retrouvez les sources qui comptent, sans bruit."|trans }}</p>

            {% if error %}
                <div class="mt-6 border-l-2 border-danger bg-surface-muted p-4 text-sm text-danger" role="alert">{{ "Identifiants invalides."|trans }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="mt-8 space-y-5">
                <label class="block text-sm font-medium text-foreground" for="username">{{ "Adresse e-mail"|trans }}</label>
                <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none transition focus:border-accent focus:ring-1 focus:ring-accent" id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="email" required autofocus>
                <label class="block text-sm font-medium text-foreground" for="password">{{ "Mot de passe"|trans }}</label>
                <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none transition focus:border-accent focus:ring-1 focus:ring-accent" id="password" name="_password" type="password" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label class="flex items-center gap-3 text-sm text-foreground"><input type="checkbox" name="_remember_me" value="1">{{ 'Rester connecté pendant 7 jours'|trans }}</label>
                <button class="w-full bg-accent px-4 py-3 text-sm font-bold uppercase tracking-[.16em] text-accent-foreground transition hover:bg-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface" type="submit">{{ "Se connecter"|trans }}</button>
            </form>
            <p class="mt-7 border-t border-line pt-5 text-center text-sm text-muted">{{ "Nouveau dans Zunaflux ?"|trans }} <a class="font-semibold text-accent underline decoration-accent underline-offset-4 hover:text-accent" href="{{ path('app_register') }}">{{ "Créer un compte"|trans }}</a></p>
        </section>
    </main>
{% endblock %}
