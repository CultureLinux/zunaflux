{% extends 'base.html.twig' %}

{% block title %}Connexion · Zunaflux{% endblock %}

{% block body %}
    <main class="relative isolate grid min-h-screen place-items-center overflow-hidden px-6 py-12">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_20%,rgba(34,211,238,.17),transparent_29rem),radial-gradient(circle_at_84%_78%,rgba(249,115,22,.13),transparent_25rem)]"></div>
        <section class="w-full max-w-md border border-cyan-100/20 bg-slate-900/75 p-8 shadow-2xl shadow-cyan-950/40 backdrop-blur md:p-10">
            <p class="mb-6 font-mono text-xs uppercase tracking-[.35em] text-cyan-300">Zunaflux / lecteur personnel</p>
            <h1 class="font-serif text-4xl leading-none text-white">Bienvenue dans Zunaflux</h1>
            <p class="mt-4 text-sm leading-6 text-slate-300">Retrouvez les sources qui comptent, sans bruit.</p>

            {% if error %}
                <div class="mt-6 border-l-2 border-orange-400 bg-orange-300/10 p-4 text-sm text-orange-100" role="alert">Identifiants invalides.</div>
            {% endif %}
            {% for message in app.flashes('success') %}
                <div class="mt-6 border-l-2 border-emerald-400 bg-emerald-300/10 p-4 text-sm text-emerald-100" role="status">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_login') }}" class="mt-8 space-y-5">
                <label class="block text-sm font-medium text-slate-200" for="username">Adresse e-mail</label>
                <input class="mt-2 w-full border border-slate-600 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="email" required autofocus>
                <label class="block text-sm font-medium text-slate-200" for="password">Mot de passe</label>
                <input class="mt-2 w-full border border-slate-600 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" id="password" name="_password" type="password" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="w-full bg-cyan-300 px-4 py-3 text-sm font-bold uppercase tracking-[.16em] text-slate-950 transition hover:bg-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-100 focus:ring-offset-2 focus:ring-offset-slate-900" type="submit">Se connecter</button>
            </form>
            <p class="mt-7 border-t border-slate-700 pt-5 text-center text-sm text-slate-400">Nouveau dans Zunaflux ? <a class="font-semibold text-cyan-200 underline decoration-cyan-500/50 underline-offset-4 hover:text-cyan-100" href="{{ path('app_register') }}">Créer un compte</a></p>
        </section>
    </main>
{% endblock %}
