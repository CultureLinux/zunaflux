{% extends 'base.html.twig' %}

{% block title %}Créer un compte · Zunaflux{% endblock %}

{% block body %}
    <main class="relative isolate grid min-h-screen place-items-center overflow-hidden px-6 py-12">
        <section class="w-full max-w-md border border-line bg-surface p-8 md:p-10">
            <a class="font-mono text-xs uppercase tracking-[.35em] text-accent hover:text-accent" href="{{ path('app_home') }}">Zunaflux / lecteur personnel</a>
            <h1 class="mt-6 font-serif text-4xl leading-none text-foreground">Commencez votre veille.</h1>
            <p class="mt-4 text-sm leading-6 text-foreground">Créez votre espace de lecture, à votre rythme.</p>

            <form method="post" action="{{ path('app_register') }}" class="mt-8 space-y-5">
                <div>
                    <label class="block text-sm font-medium text-foreground" for="email">Adresse e-mail</label>
                    <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none transition focus:border-accent focus:ring-1 focus:ring-accent" id="email" name="email" type="email" autocomplete="email" required autofocus>
                </div>
                <div>
                    <label class="block text-sm font-medium text-foreground" for="password">Mot de passe</label>
                    <input class="mt-2 w-full border border-line bg-background px-4 py-3 text-foreground outline-none transition focus:border-accent focus:ring-1 focus:ring-accent" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required aria-describedby="password-hint">
                    <p class="mt-2 text-xs text-muted" id="password-hint">12 caractères minimum.</p>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                <button class="w-full bg-accent px-4 py-3 text-sm font-bold uppercase tracking-[.16em] text-accent-foreground transition hover:bg-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface" type="submit">Créer mon compte</button>
            </form>
            <p class="mt-7 border-t border-line pt-5 text-center text-sm text-muted">Déjà inscrit ? <a class="font-semibold text-accent underline decoration-accent underline-offset-4 hover:text-accent" href="{{ path('app_login') }}">Se connecter</a></p>
        </section>
    </main>
{% endblock %}
