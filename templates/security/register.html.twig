{% extends 'base.html.twig' %}

{% block title %}Créer un compte · Zunaflux{% endblock %}

{% block body %}
    <main class="relative isolate grid min-h-screen place-items-center overflow-hidden px-6 py-12">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_85%_15%,rgba(249,115,22,.16),transparent_27rem),radial-gradient(circle_at_18%_80%,rgba(34,211,238,.15),transparent_32rem)]"></div>
        <section class="w-full max-w-md border border-cyan-100/20 bg-slate-900/75 p-8 shadow-2xl shadow-cyan-950/40 backdrop-blur md:p-10">
            <a class="font-mono text-xs uppercase tracking-[.35em] text-cyan-300 hover:text-cyan-100" href="{{ path('app_home') }}">Zunaflux / lecteur personnel</a>
            <h1 class="mt-6 font-serif text-4xl leading-none text-white">Commencez votre veille.</h1>
            <p class="mt-4 text-sm leading-6 text-slate-300">Créez votre espace de lecture, à votre rythme.</p>

            {% for message in app.flashes('error') %}
                <div class="mt-6 border-l-2 border-orange-400 bg-orange-300/10 p-4 text-sm text-orange-100" role="alert">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_register') }}" class="mt-8 space-y-5">
                <div>
                    <label class="block text-sm font-medium text-slate-200" for="email">Adresse e-mail</label>
                    <input class="mt-2 w-full border border-slate-600 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" id="email" name="email" type="email" autocomplete="email" required autofocus>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-200" for="password">Mot de passe</label>
                    <input class="mt-2 w-full border border-slate-600 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required aria-describedby="password-hint">
                    <p class="mt-2 text-xs text-slate-400" id="password-hint">12 caractères minimum.</p>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                <button class="w-full bg-cyan-300 px-4 py-3 text-sm font-bold uppercase tracking-[.16em] text-slate-950 transition hover:bg-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-100 focus:ring-offset-2 focus:ring-offset-slate-900" type="submit">Créer mon compte</button>
            </form>
            <p class="mt-7 border-t border-slate-700 pt-5 text-center text-sm text-slate-400">Déjà inscrit ? <a class="font-semibold text-cyan-200 underline decoration-cyan-500/50 underline-offset-4 hover:text-cyan-100" href="{{ path('app_login') }}">Se connecter</a></p>
        </section>
    </main>
{% endblock %}
