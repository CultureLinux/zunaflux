# Copy this file to docker/.env, then replace every placeholder before starting services.
APP_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Europe/Paris
DATABASE_URL=mysql://zunaflux:replace-with-url-encoded-password@database:3306/zunaflux?serverVersion=mariadb-10.11.0&charset=utf8mb4
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async
MARIADB_DATABASE=zunaflux
MARIADB_USER=zunaflux
MARIADB_PASSWORD=replace-with-a-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-root-password
ZUNAFLUX_PUBLIC_REGISTRATION=0
ZUNAFLUX_MAX_ACCOUNTS=
ZUNAFLUX_RETENTION_MONTHS=12
ZUNAFLUX_HTTP_PORT=8080
ZUNAFLUX_IMAGE_TAG=latest
ZUNAFLUX_COLLECTION_INTERVAL=900
# Optional Web Push and Matomo settings. Paths must exist inside the application containers.
# ZUNAFLUX_VAPID_PUBLIC_FILE=/run/secrets/vapid-public.txt
# ZUNAFLUX_VAPID_PRIVATE_FILE=/run/secrets/vapid-private.pem
# ZUNAFLUX_VAPID_SUBJECT=mailto:contact@example.com
# MATOMO_URL=
# MATOMO_SITE_ID=
